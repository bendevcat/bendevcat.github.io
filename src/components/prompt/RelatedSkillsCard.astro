---
/**
 * RelatedSkillsCard.astro (plan 16, T5 ; inventaire §6) — carte Skills liés
 * de la colonne de la fiche prompt ; la page l'omet sans skill liée.
 *
 * `.card` rayon 18, ombre `var(--shadow)` (en style, jamais l'utilitaire
 * `.shadow`, figé en clair au build), padding 20, hors index de recherche.
 * Libellé mono 10 capitales .12em `muted` ; par skill un lien `.card-inner`
 * (padding 12) : titre 14 / 600 `ink` (survol `accent`), `v<version>` mono 10
 * `accent` (omis sans version), description 12.5 px `muted` sur 2 lignes au
 * plus.
 *
 * Crochet lu par scripts/check-prompt.mjs : `data-prompt-skills`.
 */
interface Props {
  skills: { id: string; title: string; version?: string; description: string }[];
}

const { skills } = Astro.props;
---

<section
  class="card rounded-aside p-5"
  style="box-shadow: var(--shadow);"
  aria-labelledby="prompt-related-skills"
  data-prompt-skills
  data-pagefind-ignore
>
  <h2 id="prompt-related-skills" class="font-mono text-[10px] tracking-[.12em] text-muted uppercase">Skills liés</h2>
  <ul class="mt-3 flex flex-col gap-2">
    {
      skills.map((skill) => (
        <li>
          <a href={`/skills/${skill.id}/`} class="card-inner group block p-3">
            <span class="flex items-baseline justify-between gap-2">
              <span class="min-w-0 font-sans text-sm leading-[1.35] font-semibold text-ink transition-colors group-hover:text-accent">
                {skill.title}
              </span>
              {skill.version && <span class="shrink-0 font-mono text-[10px] text-accent">v{skill.version}</span>}
            </span>
            <span class="mt-1 line-clamp-2 block font-sans text-[12.5px] leading-[1.45] text-muted">
              {skill.description}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
