---
/**
 * RelatedPromptsCard.astro (plan 16, T5 ; inventaire §6) — carte Prompts liés
 * de la colonne de la fiche prompt ; la page l'omet sans prompt lié.
 *
 * Même cadre que RelatedSkillsCard (`.card` rayon 18, ombre, padding 20, hors
 * index). Par prompt un lien `.card-inner` (padding 12) : format mono 10
 * `accent`, titre 14 / 500 `ink` (survol `accent`), outil mono 10 `muted` ;
 * puis `Tous les prompts →` 13 / 600 `accent` vers `/prompts/`.
 *
 * Crochet lu par scripts/check-prompt.mjs : `data-prompt-related`.
 *
 * Plan 17 (T3, D117) — réutilisée par la fiche skill (`Prompts du skill`) :
 * props optionnelles `label` (titre, défaut `Prompts liés`), `headingId` (id
 * du titre, défaut `prompt-related-prompts`) et `tool` (ligne outil, défaut
 * affichée). Sans elles, le rendu de la fiche prompt est inchangé.
 */
interface Props {
  prompts: { id: string; title: string; format: string; tool?: string }[];
  /** Titre de la carte. */
  label?: string;
  /** Id du titre, cible de `aria-labelledby`. */
  headingId?: string;
  /** Afficher la ligne outil de chaque prompt. */
  tool?: boolean;
}

const { prompts, label = 'Prompts liés', headingId = 'prompt-related-prompts', tool = true } = Astro.props;
---

<section
  class="card rounded-aside p-5"
  style="box-shadow: var(--shadow);"
  aria-labelledby={headingId}
  data-prompt-related
  data-pagefind-ignore
>
  <h2 id={headingId} class="font-mono text-[10px] tracking-[.12em] text-muted uppercase">{label}</h2>
  <ul class="mt-3 flex flex-col gap-2">
    {
      prompts.map((prompt) => (
        <li>
          <a href={`/prompts/${prompt.id}/`} class="card-inner group flex flex-col gap-1 p-3">
            <span class="font-mono text-[10px] text-accent">{prompt.format}</span>
            <span class="font-sans text-sm leading-[1.35] font-medium text-pretty text-ink transition-colors group-hover:text-accent">
              {prompt.title}
            </span>
            {tool && prompt.tool && <span class="font-mono text-[10px] text-muted">{prompt.tool}</span>}
          </a>
        </li>
      ))
    }
  </ul>
  <a
    href="/prompts/"
    class="mt-4 inline-block font-sans text-[13px] font-semibold text-accent underline-offset-4 hover:underline"
    data-prompt-all>Tous les prompts →</a
  >
</section>
