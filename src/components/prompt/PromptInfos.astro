---
/**
 * PromptInfos.astro (plan 16, T5 ; inventaire §6) — panneau `infos` de la
 * colonne de la fiche prompt. Hors index de recherche.
 *
 * - `Fiche technique` 13 / 600 `ink`.
 * - `<dl>` : libellé mono 11 `muted` à gauche, valeur mono 11 à droite,
 *   lignes séparées d'un filet `line2` — `format` (pilule `accentSoft` /
 *   `accent`), `outil`, `modèle` (omis sans valeur), `longueur`
 *   (`N lignes · ~N tokens`), `version · date` (omise sans aucune des deux),
 *   `tags` (TagChip, gardés de la page d'avant ; omis sans tag).
 * - Filet `line2`, puis `Vient du skill` → la première skill liée
 *   (relatedSkillIds), omis sans skill liée.
 *
 * Crochets lus par scripts/check-prompt.mjs : `data-prompt-infos`,
 * `data-prompt-origin`.
 */
import TagChip from '../TagChip.astro';

interface Props {
  format: string;
  tool: string;
  model?: string;
  /** `N lignes · ~N tokens`. */
  length: string;
  /** `v<version> — <date>`, une seule partie, ou `null`. */
  versionDate: string | null;
  tags: string[];
  /** Première skill liée, ou `null`. */
  origin: { id: string; title: string } | null;
}

const { format, tool, model, length, versionDate, tags, origin } = Astro.props;
const ROW = 'flex items-center justify-between gap-3 border-t border-line2 py-2.5 first:border-t-0 first:pt-0 last:pb-0';
const LABEL = 'shrink-0 font-mono text-[11px] text-muted';
const VALUE = 'min-w-0 text-right font-mono text-[11px] [overflow-wrap:anywhere] text-ink';
---

<div data-prompt-infos data-pagefind-ignore>
  <p class="font-sans text-[13px] font-semibold text-ink">Fiche technique</p>
  <dl class="mt-3 flex flex-col">
    <div class={ROW}>
      <dt class={LABEL}>format</dt>
      <dd class="text-right">
        <span class="rounded-pill bg-accentSoft px-2 py-1 font-mono text-[11px] leading-none text-accent">{format}</span>
      </dd>
    </div>
    <div class={ROW}>
      <dt class={LABEL}>outil</dt>
      <dd class={VALUE}>{tool}</dd>
    </div>
    {
      model && (
        <div class={ROW}>
          <dt class={LABEL}>modèle</dt>
          <dd class={VALUE}>{model}</dd>
        </div>
      )
    }
    <div class={ROW}>
      <dt class={LABEL}>longueur</dt>
      <dd class={VALUE}>{length}</dd>
    </div>
    {
      versionDate && (
        <div class={ROW}>
          <dt class={LABEL}>version · date</dt>
          <dd class={VALUE}>{versionDate}</dd>
        </div>
      )
    }
    {
      tags.length > 0 && (
        <div class={ROW}>
          <dt class={LABEL}>tags</dt>
          <dd class="min-w-0">
            <ul class="flex flex-wrap justify-end gap-1.5" aria-label="Tags">
              {tags.map((tag) => (
                <TagChip tag={tag} />
              ))}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>
  {
    origin && (
      <div class="mt-4 flex items-center justify-between gap-3 border-t border-line2 pt-4">
        <span class={LABEL}>Vient du skill</span>
        <a
          href={`/skills/${origin.id}/`}
          class="min-w-0 text-right font-mono text-[11px] text-accent underline-offset-4 hover:underline"
          data-prompt-origin={origin.id}
        >
          {origin.title} →
        </a>
      </div>
    )
  }
</div>
