---
/**
 * SkillInfos.astro (plan 17, T4 ; inventaire §8) — panneau `infos` de la
 * colonne de la fiche skill. Hors index de recherche.
 *
 * `Fiche technique` 13 / 600 `ink` ; `<dl>` : libellé mono 11 `muted` à
 * gauche, valeur mono 11 à droite, lignes séparées d'un filet `line2` —
 * `type` (pilule `accentSoft` / `accent`), `version`, `licence`, `contenu`
 * (le résumé de la carte de `/skills/`), `maj.` (chacune omise sans valeur),
 * `tags` (TagChip, gardés de la page d'avant ; omis sans tag). Puis, avec
 * `repoUrl`, `code source ↗` (nouvel onglet, `noopener noreferrer`).
 *
 * Crochets lus par scripts/check-skill.mjs : `data-skill-infos`,
 * `data-info-field`, `data-skill-repo`.
 */
import TagChip from '../TagChip.astro';

interface Props {
  type: string;
  /** `v<version>` ou `null`. */
  version: string | null;
  license: string | null;
  summary: string | null;
  updated: string | null;
  tags: string[];
  repoUrl?: string;
}

const { type, version, license, summary, updated, tags, repoUrl } = Astro.props;
const ROW = 'flex items-center justify-between gap-3 border-t border-line2 py-2.5 first:border-t-0 first:pt-0 last:pb-0';
const LABEL = 'shrink-0 font-mono text-[11px] text-muted';
const VALUE = 'min-w-0 text-right font-mono text-[11px] [overflow-wrap:anywhere] text-ink';
const rows = [
  { key: 'version', label: 'version', value: version },
  { key: 'license', label: 'licence', value: license },
  { key: 'summary', label: 'contenu', value: summary },
  { key: 'updated', label: 'maj.', value: updated },
].filter((row) => row.value);
---

<div data-skill-infos data-pagefind-ignore>
  <p class="font-sans text-[13px] font-semibold text-ink">Fiche technique</p>
  <dl class="mt-3 flex flex-col">
    <div class={ROW}>
      <dt class={LABEL}>type</dt>
      <dd class="text-right">
        <span class="rounded-pill bg-accentSoft px-2 py-1 font-mono text-[11px] leading-none text-accent" data-info-field="type">
          {type}
        </span>
      </dd>
    </div>
    {
      rows.map((row) => (
        <div class={ROW}>
          <dt class={LABEL}>{row.label}</dt>
          <dd class={VALUE} data-info-field={row.key}>
            {row.value}
          </dd>
        </div>
      ))
    }
    {
      tags.length > 0 && (
        <div class={ROW}>
          <dt class={LABEL}>tags</dt>
          <dd class="min-w-0">
            <ul class="flex flex-wrap justify-end gap-1.5" aria-label="Tags">
              {tags.map((tag) => (
                <TagChip tag={tag} />
              ))}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>
  {
    repoUrl && (
      <div class="mt-4 border-t border-line2 pt-4 text-right">
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[11px] text-accent underline-offset-4 hover:underline"
          data-skill-repo
        >
          code source ↗
        </a>
      </div>
    )
  }
</div>
