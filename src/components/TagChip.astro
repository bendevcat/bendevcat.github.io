---
/*
  TagChip.astro (Plan 10 / T2) — LA puce de tag du site (contrat E10, §2.3).

  Ton = `tagTone(tag)` : hash stable du SLUG, donc un tag a le même ton sur
  toutes les pages (`Claude Code` et `claude-code` compris). La puce porte
  `data-tag="<slug>"` et `data-tone="<ton>"` — lus par
  scripts/check-secondary.mjs (R4) — et les trois utilitaires du ton
  (`TONE_CLASSES`, fond / texte / couleur de bordure) ; jamais `text-muted`.

  Rendu : `<a>` quand `href` est donné (liens de /tags), `<li>` sinon — la
  puce se pose alors directement dans un `<ul aria-label="Tags">`.
  Le contenu du slot (ex. le compte sur /tags) suit le libellé, dans l'encre
  du ton. `label` (liens seulement) devient l'`aria-label` du lien : sur
  /tags, « <tag> <compte> » avec une espace, sinon le nom accessible se lit
  « claude-code5 » (plan 11, R15).

  `shape="tag"` (plan 12, T5) : la puce du rail de /blog (prototype 163–227) —
  rayon 8 (`rounded-tag`), padding 4/9, mono 10. La forme `pill` par défaut
  rend exactement les mêmes classes qu'avant (check-secondary.mjs).
*/
import { tagSlug, tagTone } from '../lib/tags';
import { TONE_CLASSES } from '../lib/tones';

interface Props {
  tag: string;
  href?: string;
  /** Nom accessible du lien (`aria-label`), quand le texte visible ne suffit pas. */
  label?: string;
  /** Classes de mise en page supplémentaires (padding, gap…). */
  class?: string;
  /** `pill` (défaut, toutes les pages) ou `tag` (rail de /blog). */
  shape?: 'pill' | 'tag';
}

const { tag, href, label, class: extra, shape = 'pill' } = Astro.props;
const slug = tagSlug(tag);
const tone = tagTone(tag);
const SHAPES = {
  pill: { base: 'rounded-pill border font-mono text-xs', padding: 'px-2 py-0.5', gap: 'gap-2' },
  tag: { base: 'rounded-tag border font-mono text-[10px]', padding: 'px-[9px] py-1', gap: 'gap-1' },
} as const;
const { base, padding, gap } = SHAPES[shape];
const classes = [base, TONE_CLASSES[tone], extra ?? padding];
---

{
  href ? (
    <a
      href={href}
      aria-label={label}
      data-tag={slug}
      data-tone={tone}
      class:list={[...classes, `inline-flex items-center ${gap} transition-colors hover:border-current`]}
    >
      {tag}
      <slot />
    </a>
  ) : (
    <li data-tag={slug} data-tone={tone} class:list={classes}>
      {tag}
      <slot />
    </li>
  )
}
