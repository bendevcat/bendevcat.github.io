---
/*
  Accueil, rangée 1 — « Derniers articles » (Plan 9, Home map ; D28).
  Une `.card` sur `bg`, pas un `.panel` : seule la rangée 2 est teintée.
  Badge 28×28 à droite du titre, glyphe `blog` du header (D30). Chaque entrée :
  vignette 72 px (Thumbnail `square`), catégorie en mono d'accent, titre
  17 px / 500, puis `date · temps de lecture · emoji label` en mono.
  Balisage `data-home*` : convention lue par scripts/check-home.mjs (R2).
*/
import type { CollectionEntry } from 'astro:content';
import { AI_USAGE_META } from '../../lib/aiUsage';
import { estimateReadingMinutes } from '../../lib/posts';
import Icon from '../Icon.astro';
import Thumbnail from '../Thumbnail.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const items = posts.map((post) => {
  const usage = post.data.aiUsage ? AI_USAGE_META[post.data.aiUsage] : null;
  return {
    post,
    href: `/blog/${post.id}/`,
    dateFr: post.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }),
    readingMinutes: estimateReadingMinutes(post.body ?? ''),
    usage,
  };
});
---

<section class="card flex min-w-0 flex-col p-4 sm:p-5" data-home="latest" aria-labelledby="home-latest-title">
  <div class="flex items-center justify-between gap-3">
    <h2 id="home-latest-title" class="text-[17px] font-semibold tracking-[-.01em] text-ink">Derniers articles</h2>
    <span class="grid size-7 shrink-0 place-items-center rounded-badge bg-badgeBg text-badgeInk" aria-hidden="true">
      <Icon name="blog" size={14} />
    </span>
  </div>

  <ul class="mt-3 flex flex-col divide-y divide-line2">
    {
      items.map(({ post, href, dateFr, readingMinutes, usage }) => (
        <li class="py-3" data-home-item>
          <article class="group relative flex items-start gap-3">
            <div class="min-w-0 flex-1">
              <p class="font-mono text-[11px] text-accent">{post.data.category}</p>
              <h3 class="mt-1 text-[17px] leading-[1.3] font-medium break-words text-ink transition-colors group-hover:text-accent">
                <a href={href} class="after:absolute after:inset-0" data-home-title>
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-1.5 font-mono text-[11px] text-dim">
                <time datetime={post.data.pubDate.toISOString()}>{dateFr}</time> · {readingMinutes} min
                {/* Marqueur IA insécable (plan 11, R13) ; « · » et le marqueur
                    restent sur UNE ligne (Astro mange le blanc à saut de ligne). */}
                {usage && <span> · <span class="whitespace-nowrap" data-ai-marker>{usage.emoji} {usage.label}</span></span>}
              </p>
            </div>
            <Thumbnail
              cover={post.data.cover}
              coverAlt={post.data.coverAlt}
              title={post.data.title}
              derivedFrom={post.data.category}
              size="square"
            />
          </article>
        </li>
      ))
    }
  </ul>

  <a href="/blog/" class="mt-auto pt-3 text-sm font-medium text-accent transition-opacity hover:opacity-80">
    Plus d'articles →
  </a>
</section>
