---
/*
  Accueil, rangée 2 — une entrée de panneau de section : un lien `.card-inner`
  vers la fiche (Plan 9, Home map). Posée dans un `.panel`, jamais dans une
  `.card` (V2, R9). Trois jeux de champs, tous lus dans le contenu (D26, D34) :
  - projet : titre + puce de statut (PROJECT_STATUS_META tel quel — sa palette
    est celle du plan 11), description, stack en mono jointe par ` · ` ;
  - prompt : puce de format + outil en mono, titre, description ;
  - skill : titre + puce `v<version>` si renseignée, description, `type · name`
    en mono (`type` seul sans `name`).
  Mono pour les données machine seulement ; titre et description en Nebula
  Sans (§3.1, R8).
  Description anglaise : `lang="en"` (quoteLang ; plan 18, T2, WCAG 3.1.2) ;
  française : pas d'attribut, comme SkillHeader.
  Balisage `data-home-field` : convention lue par scripts/check-home.mjs (R3).
*/
import type { ProjectEntry } from '../../lib/projects';
import type { PromptEntry } from '../../lib/prompts';
import type { SkillEntry } from '../../lib/skills';
import { PROJECT_STATUS_META } from '../../lib/projectStatus';
import { quoteLang } from '../../lib/skillDetail';

export type SectionItem =
  | { kind: 'project'; entry: ProjectEntry }
  | { kind: 'prompt'; entry: PromptEntry }
  | { kind: 'skill'; entry: SkillEntry };

type Props = SectionItem;

const item = Astro.props;
const { title, description } = item.entry.data;

const chipBase = 'w-fit shrink-0 rounded-pill border px-2 py-0.5 font-mono text-[11px]';
const neutralChip = `${chipBase} border-line bg-chip text-muted`;

let href: string;
/** Puce à droite du titre (projet : statut ; skill : version). */
let titleChip: { label: string; class: string } | null = null;
/** Ligne au-dessus du titre (prompt : format + outil). */
let lead: { chip: string; text: string } | null = null;
/** Ligne mono sous la description (projet : stack ; skill : type · name). */
let meta: string | null = null;

switch (item.kind) {
  case 'project': {
    const status = PROJECT_STATUS_META[item.entry.data.status];
    href = `/projets/${item.entry.id}/`;
    titleChip = { label: status.label, class: `${chipBase} ${status.chipClass}` };
    meta = item.entry.data.stack.join(' · ') || null;
    break;
  }
  case 'prompt': {
    href = `/prompts/${item.entry.id}/`;
    lead = { chip: item.entry.data.format, text: item.entry.data.tool };
    break;
  }
  case 'skill': {
    const { type, name, version } = item.entry.data;
    href = `/skills/${item.entry.id}/`;
    if (version) titleChip = { label: `v${version}`, class: neutralChip };
    meta = [type, name].filter(Boolean).join(' · ');
    break;
  }
}
---

<a href={href} class="card-inner group flex min-w-0 flex-col gap-2 p-3 transition-colors hover:border-accent/50">
  {
    lead && (
      <div class="flex flex-wrap items-center gap-2" data-home-field="meta">
        <span class={neutralChip}>{lead.chip}</span>
        <span class="font-mono text-[11px] text-dim">{lead.text}</span>
      </div>
    )
  }

  <div class="flex items-start justify-between gap-2">
    <h3
      class="min-w-0 text-[17px] leading-[1.3] font-medium break-words text-ink transition-colors group-hover:text-accent"
      data-home-field="title"
    >
      {title}
    </h3>
    {titleChip && <span class={titleChip.class}>{titleChip.label}</span>}
  </div>

  <p
    lang={quoteLang(description) === 'en' ? 'en' : undefined}
    class="text-[13px] leading-[1.5] break-words text-muted"
    data-home-field="description"
  >
    {description}
  </p>

  {meta && <p class="font-mono text-[11px] break-words text-dim" data-home-field="meta">{meta}</p>}
</a>
