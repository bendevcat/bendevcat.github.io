---
/**
 * PromptCard.astro — carte de la grille /prompts (plan 14, T5 ; inventaire
 * §5, prototype 524–580, D92–D94).
 *
 * Un `.card` (surface, rayon 20) posé sur le fond de page, padding
 * 22/22/18, écart 12 — sans vignette, sans puces de tag, sans variante « à
 * la une » (D92). Ligne du haut, mono 10 : pilule de format (`accentSoft` /
 * `accent`), pilule d'outil (`chip` / `muted`), puis `v<version>` `muted`
 * poussé à droite, seulement quand la fiche en déclare une. Titre h2
 * 18 / 600 ; description 13,5 `muted` qui prend la hauteur libre ; pied
 * (filet `line2`, mono 10,5 `muted`) : `N variables` (`accent`, seulement
 * au-delà de 0) · `N l.` · `~N tk`, puis `ouvrir la fiche →` à droite.
 *
 * Les chaînes viennent de promptCardData() (src/lib/listCards.ts, D94) ;
 * `null` = emplacement absent. Chaque valeur affichée porte
 * `data-card-field`, lu par scripts/check-lists.mjs.
 *
 * Le lien du titre est étiré sur toute la carte (`after:inset-0`) : une
 * seule cible, aucun lien imbriqué. Survol : fond `cardHover`, titre `accent`.
 */
import type { CollectionEntry } from 'astro:content';
import { promptCardData } from '../lib/listCards';

interface Props {
  prompt: CollectionEntry<'prompts'>;
}

const { prompt } = Astro.props;
const { title, description, format, tool } = prompt.data;
const card = promptCardData(prompt.data, prompt.body);

// Contrat de carte commun aux listes (Plan 7 / I4), lu par
// src/scripts/list-pattern.ts : des tableaux, même pour les facettes
// mono-valeur ; JSON, pour qu'aucun libellé ne casse le parsing. Plus de
// facette tag sur /prompts (inventaire §5).
const facets = JSON.stringify({ format: [format], tool: [tool] });
// Pied : `N variables` (accent) seulement quand la fiche en déclare.
const footer = [
  { field: 'variables', text: card.variables, accent: true },
  { field: 'lines', text: card.lines, accent: false },
  { field: 'tokens', text: card.tokens, accent: false },
].filter((part) => part.text !== null);
---

<article
  class="card group relative flex flex-col gap-3 px-[22px] pt-[22px] pb-[18px] transition-colors hover:bg-cardHover"
  data-entry-id={prompt.id}
  data-facet={facets}
  data-date={0}
  data-minutes={0}
>
  <div class="flex items-center gap-2 font-mono text-[10px] leading-none">
    <span class="rounded-pill bg-accentSoft px-2 py-1 text-accent" data-card-field="format">{card.format}</span>
    <span class="rounded-pill bg-chip px-2 py-1 text-muted" data-card-field="tool">{card.tool}</span>
    {card.version && <span class="ml-auto text-muted" data-card-field="version">{card.version}</span>}
  </div>

  <h2 class="font-sans text-lg leading-snug font-semibold text-ink transition-colors group-hover:text-accent">
    <a href={`/prompts/${prompt.id}/`} class="after:absolute after:inset-0 after:rounded-card">{title}</a>
  </h2>

  <p class="flex-1 text-[13.5px] leading-normal text-muted">{description}</p>

  <div class="flex items-center gap-1.5 border-t border-line2 pt-3 font-mono text-[10.5px] text-muted">
    {
      footer.map((part, index) => (
        <>
          {index > 0 && <span aria-hidden="true">·</span>}
          <span class:list={[part.accent && 'text-accent']} data-card-field={part.field}>{part.text}</span>
        </>
      ))
    }
    <span class="ml-auto whitespace-nowrap" aria-hidden="true">ouvrir la fiche →</span>
  </div>
</article>
