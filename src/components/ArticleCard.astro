---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { AI_USAGE_META } from '../lib/aiUsage';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, tags, cover, coverAlt, aiUsage } = post.data;

const dateFr = pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Estimation grossière (~200 mots/min, arrondi au supérieur, minimum 1 min) —
// volontairement simple : `post.body` est le Markdown brut, pas de nettoyage
// de la syntaxe. Affiné plus tard si besoin (cf. rapport de tâche).
function estimateReadingMinutes(body: string): number {
  const wordCount = body.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(wordCount / 200));
}

const readingMinutes = estimateReadingMinutes(post.body ?? '');
const usage = aiUsage ? AI_USAGE_META[aiUsage] : null;
---

<article
  class="group relative flex flex-col gap-3 rounded-xl border border-line bg-surface p-4 transition-colors hover:border-acc/50"
  data-facet-card
  data-facet={JSON.stringify({ category: [category], tag: tags })}
>
  {
    cover && (
      <Image
        src={cover}
        alt={coverAlt ?? title}
        class="aspect-video w-full rounded-lg object-cover"
      />
    )
  }

  {/*
    Bouton plutôt que <span> : la puce doit rester cliquable pour filtrer
    sans imbriquer un <button> dans le lien étiré du titre (HTML invalide).
    `relative z-10` la place au-dessus du lien étiré porté par le <h3>.
  */}
  <button
    type="button"
    data-facet-chip
    data-facet-key="category"
    data-facet-value={category}
    class="relative z-10 w-fit rounded-full bg-acc-dim px-2 py-0.5 font-mono text-xs text-acc transition-colors hover:ring-1 hover:ring-acc"
  >
    {category}
  </button>

  <h3 class="font-display text-lg font-semibold text-text group-hover:text-acc">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">{title}</a>
  </h3>

  <p class="text-sm text-muted">{description}</p>

  <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-2">
    <p class="font-mono text-xs text-muted">
      {dateFr} · {readingMinutes} min de lecture
    </p>
    {
      usage && (
        <span class="font-mono text-xs text-muted" title={usage.label}>
          {usage.emoji} <span class="hidden sm:inline">{usage.label}</span>
        </span>
      )
    }
  </div>
</article>
