---
import type { CollectionEntry } from 'astro:content';
import { AI_USAGE_META } from '../lib/aiUsage';
import { estimateReadingMinutes } from '../lib/posts';
import { tagSlug } from '../lib/tags';
import Thumbnail from './Thumbnail.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  /**
   * Vrai uniquement sur une page qui porte une barre de facettes (`/blog`).
   * Ailleurs — la home, et toute page future qui réutiliserait cette carte —
   * la puce redevient un simple `<span>` dans le lien de carte : rien à
   * traverser au pointeur, rien à tabuler, et aucun nom accessible qui
   * promettrait un filtre inexistant.
   */
  filterable?: boolean;
  /** Variante « à la une » : carte large, vignette au format 16/7. */
  featured?: boolean;
  /** Masquée côté serveur — la même entrée est déjà rendue dans le bloc à la une. */
  hidden?: boolean;
  /**
   * Vrai sur l'entrée que le serveur a RÉELLEMENT désignée via
   * `pickFeaturedEntry()` (spec §6.1) — indépendant de `featured`, qui ne
   * pilote que la mise en page. Pilote `data-featured` (fix 3, revue finale).
   */
  isFeaturedEntry?: boolean;
}

const {
  post,
  filterable = false,
  featured = false,
  hidden = false,
  isFeaturedEntry = false,
} = Astro.props;
const { title, description, pubDate, category, tags, cover, coverAlt, aiUsage } = post.data;

const dateFr = pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const readingMinutes = estimateReadingMinutes(post.body ?? '');
const usage = aiUsage ? AI_USAGE_META[aiUsage] : null;
---

{/*
  Contrat de carte commun aux quatre listes (Plan 7 / I4), lu par
  src/scripts/list-pattern.ts — même forme que ProjectCard.astro. `data-facet`
  est du JSON : aucune valeur de facette ne peut casser le parsing, quel que
  soit son libellé. `data-date` = pubDate en millisecondes, `data-minutes` =
  temps de lecture estimé : ce sont les deux clés que lisent les tris
  shortest/longest et recent/oldest (R7). `data-featured` reflète le choix
  RÉEL du serveur (`isFeaturedEntry`), pas la seule présence de
  `post.data.featured` : sur /blog aucune entrée ne porte ce champ à ce jour,
  et les deux côtés ne s'accordaient que par coïncidence d'ordre — fix 3,
  revue finale de Plan 7.
*/}
<article
  class:list={[
    'group relative flex flex-col gap-3 rounded-card border border-line bg-surface p-4 transition-colors hover:border-accent/50',
    featured && 'sm:col-span-2 lg:col-span-3',
  ]}
  data-entry-id={post.id}
  data-facet={JSON.stringify({ category: [category], tag: tags.map(tagSlug) })}
  data-date={pubDate.getTime()}
  data-minutes={readingMinutes}
  data-featured={isFeaturedEntry ? '' : undefined}
  hidden={hidden}
>
  <Thumbnail
    cover={cover}
    coverAlt={coverAlt}
    title={title}
    derivedFrom={category}
    size={featured ? 'featured' : 'card'}
  />

  {
    filterable ? (
      /*
        Bouton plutôt que <span> : la puce doit rester cliquable pour filtrer
        sans imbriquer un <button> dans le lien étiré du titre (HTML invalide).
        `relative z-10` la place au-dessus de ce lien étiré.
        `pointer-events-none` et `tabindex={-1}` sont l'état PAR DÉFAUT, y
        compris ici : sans JavaScript, la barre de facettes reste masquée et la
        puce ne filtrerait rien — inerte, elle laisse le clic atteindre le lien
        étiré et la carte s'ouvre. src/scripts/blog-filters.ts la réveille.
      */
      <button
        type="button"
        data-facet-chip
        data-facet-key="category"
        data-facet-value={category}
        tabindex={-1}
        class="pill pointer-events-none relative z-10 w-fit text-xs transition-colors hover:ring-1 hover:ring-accent"
      >
        {category}
      </button>
    ) : (
      <span class="pill w-fit text-xs">
        {category}
      </span>
    )
  }

  <h3 class="font-sans text-lg font-semibold text-ink group-hover:text-accent">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">{title}</a>
  </h3>

  <p class="text-sm text-muted">{description}</p>

  <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-2">
    <p class="font-mono text-xs text-muted">
      {dateFr} · {readingMinutes} min de lecture
    </p>
    {
      usage && (
        <span class="font-mono text-xs text-muted" title={usage.label}>
          {usage.emoji} <span class="hidden sm:inline">{usage.label}</span>
        </span>
      )
    }
  </div>
</article>
