---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { AI_USAGE_META } from '../lib/aiUsage';
import { tagSlug } from '../lib/tags';

interface Props {
  post: CollectionEntry<'blog'>;
  /**
   * Vrai uniquement sur une page qui porte une barre de facettes (`/blog`).
   * Ailleurs — la home, et toute page future qui réutiliserait cette carte —
   * la puce redevient un simple `<span>` dans le lien de carte : rien à
   * traverser au pointeur, rien à tabuler, et aucun nom accessible qui
   * promettrait un filtre inexistant.
   */
  filterable?: boolean;
}

const { post, filterable = false } = Astro.props;
const { title, description, pubDate, category, tags, cover, coverAlt, aiUsage } = post.data;

const dateFr = pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Estimation grossière (~200 mots/min, arrondi au supérieur, minimum 1 min) —
// volontairement simple : `post.body` est le Markdown brut, pas de nettoyage
// de la syntaxe. Affiné plus tard si besoin (cf. rapport de tâche).
function estimateReadingMinutes(body: string): number {
  const wordCount = body.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(wordCount / 200));
}

const readingMinutes = estimateReadingMinutes(post.body ?? '');
const usage = aiUsage ? AI_USAGE_META[aiUsage] : null;
---

<article
  class="group relative flex flex-col gap-3 rounded-card border border-line bg-surface p-4 transition-colors hover:border-accent/50"
  data-facet-card
  data-facet={JSON.stringify({ category: [category], tag: tags.map(tagSlug) })}
>
  {
    cover && (
      <Image
        src={cover}
        alt={coverAlt ?? title}
        class="aspect-video w-full rounded-inner object-cover"
      />
    )
  }

  {
    filterable ? (
      /*
        Bouton plutôt que <span> : la puce doit rester cliquable pour filtrer
        sans imbriquer un <button> dans le lien étiré du titre (HTML invalide).
        `relative z-10` la place au-dessus de ce lien étiré.
        `pointer-events-none` et `tabindex={-1}` sont l'état PAR DÉFAUT, y
        compris ici : sans JavaScript, la barre de facettes reste masquée et la
        puce ne filtrerait rien — inerte, elle laisse le clic atteindre le lien
        étiré et la carte s'ouvre. src/scripts/blog-filters.ts la réveille.
      */
      <button
        type="button"
        data-facet-chip
        data-facet-key="category"
        data-facet-value={category}
        tabindex={-1}
        class="pill pointer-events-none relative z-10 w-fit text-xs transition-colors hover:ring-1 hover:ring-accent"
      >
        {category}
      </button>
    ) : (
      <span class="pill w-fit text-xs">
        {category}
      </span>
    )
  }

  <h3 class="font-sans text-lg font-semibold text-ink group-hover:text-accent">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">{title}</a>
  </h3>

  <p class="text-sm text-muted">{description}</p>

  <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-2">
    <p class="font-mono text-xs text-muted">
      {dateFr} · {readingMinutes} min de lecture
    </p>
    {
      usage && (
        <span class="font-mono text-xs text-muted" title={usage.label}>
          {usage.emoji} <span class="hidden sm:inline">{usage.label}</span>
        </span>
      )
    }
  </div>
</article>
