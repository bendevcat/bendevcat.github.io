---
/*
  Icon.astro (Plan 6 / T-C1) — les 8 glyphes du header, INLINÉS.
  Aucune dépendance runtime n'est ajoutée au projet : les tracés ont été
  extraits une fois (cf. .superpowers/…/phase-C-glyphs.md) et vivent ici.

  Sources et licences :
  - 6 glyphes en TRAIT — Lucide (`lucide-static@1.45.0`), licence ISC :
    `newspaper`, `folder-git-2`, `terminal`, `sparkles`, `user`, `search`.
  - marque GitHub en APLAT — Simple Icons (`simple-icons@16.31.0`), licence
    CC0-1.0 (domaine public). Lucide a sorti les marques de son set :
    `github.svg` n'y existe plus, d'où cette seconde source.
  - glyphe du logo (3 barres, R5) en APLAT — dessiné à la main, il n'existe
    dans aucun set.

  POURQUOI LE MODE DE RENDU EST PORTÉ PAR GLYPHE ET NON PAR LE COMPOSANT :
  un tracé Lucide est un contour (`fill: none` + `stroke: currentColor` +
  `stroke-width`), un tracé Simple Icons est un aplat (`fill: currentColor`,
  pas de stroke). Un <svg> unique portant `stroke="currentColor" fill="none"`
  ne rendrait donc RIEN pour GitHub — silencieusement : pas d'erreur de build,
  pas de test rouge, juste un carré vide dans le header. Le mode est une
  propriété du glyphe, il est déclaré à côté de son tracé.

  Tous les tracés sont en `viewBox="0 0 24 24"` : ils se mettent à l'échelle
  par `width`/`height`, et se colorent par `currentColor` — donc par la couleur
  de texte du parent, jamais par une valeur codée en dur (règle globale n°1).
*/

type IconName =
  | 'blog'
  | 'projets'
  | 'prompts'
  | 'skills'
  | 'a-propos'
  | 'search'
  | 'github'
  | 'logo';

interface Props {
  name: IconName;
  /** Côté du carré, en px. 14 = icône de pilule de nav ; 16 = bouton rond / logo. */
  size?: number;
  class?: string;
}

const { name, size = 14, class: className } = Astro.props;

type Glyph = { mode: 'stroke' | 'fill'; paths: string };

const GLYPHS: Record<IconName, Glyph> = {
  // — Lucide `newspaper` (ISC) —
  blog: {
    mode: 'stroke',
    paths: `<path d="M15 18h-5" />
<path d="M18 14h-8" />
<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2" />
<rect width="8" height="4" x="10" y="6" rx="1" />`,
  },
  // — Lucide `folder-git-2` (ISC) —
  projets: {
    mode: 'stroke',
    paths: `<path d="M18 19a5 5 0 0 1-5-5v8" />
<path d="M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5" />
<circle cx="13" cy="12" r="2" />
<circle cx="20" cy="19" r="2" />`,
  },
  // — Lucide `terminal` (ISC) —
  prompts: {
    mode: 'stroke',
    paths: `<path d="M12 19h8" />
<path d="m4 17 6-6-6-6" />`,
  },
  // — Lucide `sparkles` (ISC) —
  skills: {
    mode: 'stroke',
    paths: `<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" />
<path d="M20 2v4" />
<path d="M22 4h-4" />
<circle cx="4" cy="20" r="2" />`,
  },
  // — Lucide `user` (ISC) —
  'a-propos': {
    mode: 'stroke',
    paths: `<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
<circle cx="12" cy="7" r="4" />`,
  },
  // — Lucide `search` (ISC) —
  search: {
    mode: 'stroke',
    paths: `<path d="m21 21-4.34-4.34" />
<circle cx="11" cy="11" r="8" />`,
  },
  // — Simple Icons `github` (CC0-1.0) — APLAT, cf. note en tête de fichier —
  github: {
    mode: 'fill',
    paths: `<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />`,
  },
  // — Logo benCat (R5) : trois barres de largeurs décroissantes, APLAT —
  logo: {
    mode: 'fill',
    paths: `<rect x="3" y="5" width="18" height="3" rx="1.5" />
<rect x="3" y="10.5" width="13" height="3" rx="1.5" />
<rect x="3" y="16" width="8" height="3" rx="1.5" />`,
  },
};

const glyph = GLYPHS[name];
const isStroke = glyph.mode === 'stroke';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isStroke ? 'none' : 'currentColor'}
  stroke={isStroke ? 'currentColor' : undefined}
  stroke-width={isStroke ? 1.75 : undefined}
  stroke-linecap={isStroke ? 'round' : undefined}
  stroke-linejoin={isStroke ? 'round' : undefined}
  aria-hidden="true"
  focusable="false"
  class:list={['shrink-0', className]}
  set:html={glyph.paths}
/>
