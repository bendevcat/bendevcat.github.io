---
/**
 * StackTiles.astro (plan 15, T5 ; inventaire §4 ; prototype 433–522) — le
 * panneau Stack d'une fiche projet.
 *
 * - Libellé `// ce qui fait tourner le projet`, mono 12 `muted`, hors index
 *   de recherche.
 * - `<ul aria-label="Technologies">` en grille `auto-fill minmax(180px, 1fr)`,
 *   écart 12 ; une tuile `.card-inner` rayon 16, padding 16 par techno, dans
 *   l'ordre de `stack` (stackTiles, src/lib/projectDetail.ts) :
 *   - emplacement de logo 88 px de haut, sans fond propre : le tracé Simple
 *     Icons à 40 px en `ink`, ou, sans logo, le monogramme mono 20 / 600
 *     `muted` (`SC`, `GP`, `SVU`) — tous deux `aria-hidden`, le nom suit ;
 *   - nom 15 / 600 `ink` ;
 *   - rôle mono 10 `muted`, omis quand il n'est pas sourcé (D104).
 *
 * Crochets lus par scripts/check-project.mjs : `data-panel-label`,
 * `data-stack-tile`, `data-stack-name`, `data-stack-role`, `data-monogram`.
 */
import type { StackTile } from '../../lib/projectDetail';

interface Props {
  tiles: StackTile[];
}

const { tiles } = Astro.props;
---

<p class="font-mono text-xs text-muted" data-panel-label data-pagefind-ignore>// ce qui fait tourner le projet</p>
<ul aria-label="Technologies" class="mt-3.5 grid grid-cols-[repeat(auto-fill,minmax(180px,1fr))] gap-3">
  {
    tiles.map((tile) => (
      <li class="card-inner flex min-w-0 flex-col items-center rounded-hero p-4 text-center" data-stack-tile>
        <div class="flex h-[88px] w-full items-center justify-center text-ink">
          {tile.logo ? (
            <svg
              viewBox="0 0 24 24"
              width="40"
              height="40"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d={tile.logo.path} />
            </svg>
          ) : (
            <span class="font-mono text-xl font-semibold text-muted" aria-hidden="true" data-monogram>
              {tile.monogram}
            </span>
          )}
        </div>
        <p class="mt-2 max-w-full font-sans text-[15px] leading-snug font-semibold break-words text-ink" data-stack-name>
          {tile.name}
        </p>
        {tile.role && (
          <p class="mt-1 max-w-full font-mono text-[10px] leading-snug break-words text-muted" data-stack-role>
            {tile.role}
          </p>
        )}
      </li>
    ))
  }
</ul>
