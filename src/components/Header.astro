---
import ThemeToggle from './ThemeToggle.astro';

interface NavLink {
  label: string;
  href?: string;
}

// Nav complète du site (spec design §4). Seul Blog a une page en Plan 1 ;
// les autres piliers arrivent aux Plans 3-4 — rendus non cliquables pour
// éviter tout lien mort (cf. spec Plan 1 §5).
const navLinks: NavLink[] = [
  { label: 'Blog', href: '/blog' },
  { label: 'Projets' },
  { label: 'Prompts' },
  { label: 'Skills' },
  { label: 'À propos' },
];
---

<header class="border-b border-line">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:flex-nowrap sm:px-6"
  >
    <a href="/" class="font-mono text-lg text-text" aria-label="bencat_ — accueil">
      bencat<span class="text-acc">_</span>
    </a>

    {/*
      R9 (375px) : sur mobile, le bloc logo+toggle tient sur une ligne mais
      logo+nav(5 items)+toggle ensemble débordent (constat brief C5). On fait
      passer <nav> en 2e ligne pleine largeur (order-last + w-full) sous les
      480px environ ; dès `sm` (640px) on revient à la ligne unique d'origine
      (sm:order-none sm:w-auto), donc le layout desktop est inchangé. Pas de
      JS, pas de scroll : tous les items restent visibles et cliquables.
    */}
    <nav aria-label="Navigation principale" class="order-last w-full sm:order-none sm:w-auto">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {navLinks.map((link) => (
          <li>
            {link.href ? (
              <a href={link.href} class="text-muted transition-colors hover:text-text">
                {link.label}
              </a>
            ) : (
              <span class="text-muted/40" aria-disabled="true" title="Bientôt disponible">
                {link.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>
