---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface NavLink {
  label: string;
  href?: string;
  // Nom de glyphe (Icon.astro) — R6 : chacun des 5 items porte son icône.
  icon: 'blog' | 'projets' | 'prompts' | 'skills' | 'a-propos';
}

// Nav complète du site (spec design §4). Blog (Plan 1), Projets (Plan 3),
// Prompts et Skills (Plan 4), et « À propos » (Plan 5) ont tous une page.
// Le rendu non cliquable reste possible pour un futur item sans page :
// `href` absent → <span> inerte, pour éviter tout lien mort (spec Plan 1 §5).
const navLinks: NavLink[] = [
  { label: 'Blog', href: '/blog', icon: 'blog' },
  { label: 'Projets', href: '/projets', icon: 'projets' },
  { label: 'Prompts', href: '/prompts', icon: 'prompts' },
  { label: 'Skills', href: '/skills', icon: 'skills' },
  { label: 'À propos', href: '/a-propos', icon: 'a-propos' },
];

// R6 — l'état actif se dérive par FAMILLE DE ROUTES, pas par égalité :
// `/blog/<slug>` doit allumer « Blog ».
// Piège mesuré : en build statique, `Astro.url.pathname` porte un `/` final
// (`/blog/`, `/a-propos/`) — une comparaison `path === href` échouerait donc
// sur TOUTES les pages, y compris les routes mères. `path.startsWith(href + '/')`
// couvre à la fois la mère avec son slash final et les filles ; `path === href`
// ne sert qu'au dev server, qui lui ne pose pas de slash final.
// Sur `/` aucun item n'est actif : il n'y a pas d'item « Accueil », c'est le
// logo qui porte la racine.
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

// Look commun des pilules de nav. Rayon 999 via l'utilitaire `rounded-pill`
// (généré par Tailwind depuis `--radius-pill`) — jamais `rounded-full`, dont
// la valeur ne vient pas du contrat. Anneau de focus neutre `ink` : visible
// dans les deux thèmes, et il ne réinjecte ni le vert (contenu/action) ni le
// bleu (méta) dans un élément de navigation (contrat §2.2).
const NAV_PILL =
  'inline-flex items-center gap-1.5 rounded-pill border px-3 py-1.5 text-sm transition-colors ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink';
---

<header class="border-b border-line">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-4 sm:flex-nowrap sm:px-6"
  >
    {/*
      R5 — logo en pilule. `.pill` (contrat §4) pose rayon 999 + padding +
      fond `accentSoft` + texte `accent` + mono ; la bordure `line` demandée
      par R5 s'ajoute en utilitaire, et `inline-flex` aussi : `.pill` ne porte
      volontairement aucun `display` (règle R4), c'est ce qui la rend
      composable ici sans la modifier.
    */}
    <a
      href="/"
      aria-label="bencat_ — accueil"
      class="pill inline-flex items-center gap-2 border border-line text-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      <Icon name="logo" size={16} />
      <span>bencat<span class="text-accent">_</span></span>
    </a>

    {/*
      R11 (375px) : sur mobile, le bloc logo+actions tient sur une ligne mais
      logo+nav(5 pilules)+actions ensemble débordent. On fait passer <nav> en
      2e ligne pleine largeur (order-last + w-full) sous `sm` (640px) ; dès
      `sm` on revient à la ligne unique (sm:order-none sm:w-auto), donc le
      layout desktop est inchangé. Les pilules elles-mêmes ont le droit de
      passer à la ligne (flex-wrap). Pas de JS, pas de scroll, pas de burger
      (ce serait une structure nouvelle, hors périmètre du Plan 6) : tous les
      items restent visibles et cliquables.
    */}
    <nav aria-label="Navigation principale" class="order-last w-full sm:order-none sm:w-auto">
      <ul class="flex flex-wrap items-center gap-1.5">
        {navLinks.map((link) => (
          <li>
            {link.href ? (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  NAV_PILL,
                  isActive(link.href)
                    ? // actif : fond `nav` + bordure `line` + graisse (R6)
                      'border-line bg-nav font-medium text-ink'
                    : // inactif : transparent, texte secondaire
                      'border-transparent text-muted hover:text-ink',
                ]}
              >
                <Icon name={link.icon} />
                {link.label}
              </a>
            ) : (
              <span
                class:list={[NAV_PILL, 'border-transparent text-muted/40']}
                aria-disabled="true"
                title="Bientôt disponible"
              >
                <Icon name={link.icon} />
                {link.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      data-search-open
      hidden
      class="flex items-center gap-2 rounded-pill border border-line px-2 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
      aria-label="Rechercher sur le site"
    >
      <Icon name="search" size={16} />
      <kbd class="hidden sm:inline">⌘K</kbd>
    </button>

    <ThemeToggle />
  </div>
</header>
