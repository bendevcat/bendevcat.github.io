---
import ThemeToggle from './ThemeToggle.astro';

interface NavLink {
  label: string;
  href?: string;
}

// Nav complète du site (spec design §4). Blog (Plan 1), Projets (Plan 3),
// Prompts et Skills (Plan 4), et « À propos » (Plan 5) ont tous une page.
// Le rendu non cliquable reste possible pour un futur item sans page :
// `href` absent → <span> inerte, pour éviter tout lien mort (spec Plan 1 §5).
const navLinks: NavLink[] = [
  { label: 'Blog', href: '/blog' },
  { label: 'Projets', href: '/projets' },
  { label: 'Prompts', href: '/prompts' },
  { label: 'Skills', href: '/skills' },
  { label: 'À propos', href: '/a-propos' },
];
---

<header class="border-b border-line">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:flex-nowrap sm:px-6"
  >
    <a href="/" class="font-mono text-lg text-ink" aria-label="bencat_ — accueil">
      bencat<span class="text-accent">_</span>
    </a>

    {/*
      R9 (375px) : sur mobile, le bloc logo+toggle tient sur une ligne mais
      logo+nav(5 items)+toggle ensemble débordent (constat brief C5). On fait
      passer <nav> en 2e ligne pleine largeur (order-last + w-full) sous les
      480px environ ; dès `sm` (640px) on revient à la ligne unique d'origine
      (sm:order-none sm:w-auto), donc le layout desktop est inchangé. Pas de
      JS, pas de scroll : tous les items restent visibles et cliquables.
    */}
    <nav aria-label="Navigation principale" class="order-last w-full sm:order-none sm:w-auto">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {navLinks.map((link) => (
          <li>
            {link.href ? (
              <a href={link.href} class="text-muted transition-colors hover:text-ink">
                {link.label}
              </a>
            ) : (
              <span class="text-muted/40" aria-disabled="true" title="Bientôt disponible">
                {link.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      data-search-open
      hidden
      class="flex items-center gap-2 rounded-lg border border-line px-2 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
      aria-label="Rechercher sur le site"
    >
      <span aria-hidden="true">🔍</span>
      <kbd class="hidden sm:inline">⌘K</kbd>
    </button>

    <ThemeToggle />
  </div>
</header>
