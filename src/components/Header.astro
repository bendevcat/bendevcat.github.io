---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface NavLink {
  label: string;
  href?: string;
  // Nom de glyphe (Icon.astro) — chacun des 5 items porte son icône.
  icon: 'blog' | 'projets' | 'prompts' | 'skills' | 'a-propos';
}

// Nav complète du site, dans l'ordre du prototype (plan 12, R3 ; inventaire
// §0, markup 36–40) : Blog · Projets · Skills · Prompts · À propos.
// Le rendu non cliquable reste possible pour un futur item sans page :
// `href` absent → <span> inerte, pour éviter tout lien mort (spec Plan 1 §5).
const navLinks: NavLink[] = [
  { label: 'Blog', href: '/blog', icon: 'blog' },
  { label: 'Projets', href: '/projets', icon: 'projets' },
  { label: 'Skills', href: '/skills', icon: 'skills' },
  { label: 'Prompts', href: '/prompts', icon: 'prompts' },
  { label: 'À propos', href: '/a-propos', icon: 'a-propos' },
];

// L'état actif se dérive par FAMILLE DE ROUTES, pas par égalité :
// `/blog/<slug>` doit allumer « Blog ».
// Piège mesuré : en build statique, `Astro.url.pathname` porte un `/` final
// (`/blog/`, `/a-propos/`) — une comparaison `path === href` échouerait donc
// sur TOUTES les pages, y compris les routes mères. `path.startsWith(href + '/')`
// couvre à la fois la mère avec son slash final et les filles ; `path === href`
// ne sert qu'au dev server, qui lui ne pose pas de slash final.
// Sur `/` aucun item n'est actif : il n'y a pas d'item « Accueil », c'est le
// logo qui porte la racine.
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

// Anneau de focus `accent`, comme tout contrôle hors onglets (plan 11, D61).
const FOCUS = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';

// Les trois pilules du header (prototype 29–55) : fond `nav`, 1 px `line`,
// rayon 999 via `rounded-pill` (`--radius-pill`) — jamais `rounded-full`.
const PILL = 'rounded-pill border border-line bg-nav';

// Items de la pilule de nav : padding 8/14, rayon 999, 14 px, icône 15 px.
// Interligne 17 px (F1) : item de 33 px, pilule de 1 + 6 + 33 + 6 + 1 = 47 px,
// la hauteur du prototype (à `text-sm` seul, 20 px d'interligne → 50 px).
// `flex` et pas `inline-flex` : en boîte bloc, l'item n'hérite pas de la ligne
// (strut) du `<li>`, sa hauteur est exactement celle calculée ci-dessus.
const NAV_ITEM = `flex items-center gap-1.5 rounded-pill px-3.5 py-2 text-sm leading-[17px] transition-colors ${FOCUS}`;
// R3 — actif : `accent` sur `accentSoft`, graisse 600 (prototype) ;
// inactif : `muted` sur transparent, survol `chip` / `ink`.
const NAV_ACTIVE = 'bg-accentSoft font-semibold text-accent';
const NAV_INACTIVE = 'text-muted hover:bg-chip hover:text-ink';

// Les trois boutons ronds de la pilule d'actions : 34×34, rayon 999, fond
// `chip`, `muted` ; survol `nav` / `ink` (prototype). Une seule chaîne : les
// trois doivent être indiscernables, y compris celui que rend
// `ThemeToggle.astro` (à qui elle est passée en prop).
const ROUND_BTN =
  `grid size-8.5 place-items-center rounded-pill bg-chip text-muted transition-colors ` +
  `hover:bg-nav hover:text-ink ${FOCUS}`;
---

{/*
  Plan 12 / T2 — trois pilules séparées, sans filet bas, `padding-top: 20px`,
  `space-between` + `flex-wrap` (prototype 29–55, inventaire §0).
  F1 — `box-content` : 1180 px de contenu, padding en plus (logo à x 50,
  actions finissant à x 1230 pour 1280 px) ; `items-start` : les trois
  pilules (46, 47 et 48 px de haut) partent toutes à 20 px du haut de page.
*/}
<header>
  <div
    data-shell="header"
    class="mx-auto box-content flex max-w-shell flex-wrap items-start justify-between gap-x-4 gap-y-3 px-4 pt-5 sm:px-6"
  >
    {/*
      Pilule du logo : padding 8/18/8/12 ; tuile 28×28 rayon 9 (`rounded-badge`)
      sur `accentSoft`, trois barres `accent` de largeurs 100/60/82 % et
      d'opacités 1/.7/.45 ; `bencat` mono 15 `ink` + `_` `accent`.
    */}
    <a
      href="/"
      aria-label="bencat_ — accueil"
      class={`inline-flex items-center gap-2.5 py-2 pr-4.5 pl-3 ${PILL} ${FOCUS}`}
    >
      <span aria-hidden="true" class="flex size-7 flex-col justify-center gap-[3px] rounded-badge bg-accentSoft px-[7px]">
        <span class="h-[3px] w-full rounded-pill bg-accent"></span>
        <span class="h-[3px] w-[60%] rounded-pill bg-accent opacity-70"></span>
        <span class="h-[3px] w-[82%] rounded-pill bg-accent opacity-45"></span>
      </span>
      <span class="font-mono text-[15px] text-ink">bencat<span class="text-accent">_</span></span>
    </a>

    {/*
      Pilule de nav : padding 6, gap 4. Sous 640 px (D72) elle prend sa propre
      rangée pleine largeur (order-last + w-full) : logo + nav + actions ne
      tiennent pas sur une ligne à 375 px. Ses items y passent à la ligne,
      centrés ; son rayon descend alors à 20 px (`rounded-card`), un rayon de
      999 sur deux rangées rognerait visuellement les items des coins. Dès
      640 px elle revient entre les deux autres pilules, sur une ligne.
      Pas de JS, pas de scroll, pas de burger : tous les items restent visibles.
    */}
    <nav
      aria-label="Navigation principale"
      class="order-last w-full rounded-card border border-line bg-nav p-1.5 sm:order-none sm:w-auto sm:rounded-pill"
    >
      <ul class="flex flex-wrap items-center justify-center gap-1">
        {navLinks.map((link) => (
          <li>
            {link.href ? (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[NAV_ITEM, isActive(link.href) ? NAV_ACTIVE : NAV_INACTIVE]}
              >
                <Icon name={link.icon} size={15} />
                {link.label}
              </a>
            ) : (
              <span
                class:list={[NAV_ITEM, 'text-muted/40']}
                aria-disabled="true"
                title="Bientôt disponible"
              >
                <Icon name={link.icon} size={15} />
                {link.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    {/*
      Pilule d'actions : padding 6, gap 6, trois boutons ronds sur `chip`
      (recherche, GitHub, thème). `data-header-actions` est ce que mesure
      scripts/check-shell-blog.mjs (R2 actions). Le rappel « ⌘K » de la v1
      n'est plus affiché (D72) ; le raccourci clavier reste, dans search.ts.
    */}
    <div data-header-actions class={`flex items-center gap-1.5 p-1.5 ${PILL}`}>
      {/*
        CONTRAT À NE PAS CASSER : `data-search-open` est ce que
        `src/scripts/search.ts` cherche pour (a) retirer le `hidden` et (b)
        brancher l'ouverture du <dialog>. Le `hidden` posé par le serveur est
        l'enhancement progressif du Plan 5 : sans JS, aucun contrôle mort n'est
        affiché (la règle `[data-search-open][hidden]` de global.css le garde
        invisible en `!important`, sinon l'utilitaire `grid` ci-dessous
        gagnerait). Ne renommer ni l'un ni l'autre.
      */}
      <button
        type="button"
        data-search-open
        hidden
        class={ROUND_BTN}
        aria-label="Rechercher sur le site"
      >
        <Icon name="search" size={15} />
      </button>

      <a
        href="https://github.com/bendevcat"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub de benCat"
        class={ROUND_BTN}
      >
        <Icon name="github" size={15} />
      </a>

      <ThemeToggle class={ROUND_BTN} />
    </div>
  </div>
</header>
