---
/*
  /a-propos — « Ma boîte à outils » (plan 10, About map ; D43).
  Un `.card` sur `bg` : une pilule neutre (fond `chip`, mono) par élément de
  la stack des projets (collectStack, ordre de getSortedProjects()). Le logo,
  quand src/lib/stackLogos.ts en a un, est un `<svg>` INLINE en
  `currentColor` — jamais d'`<img>`, jamais d'URL externe (R5) ; sinon le
  texte seul (Sveltia CMS, SVU).
  Balisage `data-about` / `data-toolbox-item` : convention lue par
  scripts/check-secondary.mjs.
*/
import { stackLogo } from '../../lib/stackLogos';

interface Props {
  stack: string[];
}

const items = Astro.props.stack.map((name) => ({ name, logo: stackLogo(name) }));
---

<section class="card min-w-0 p-4 sm:p-5" data-about="toolbox" aria-labelledby="about-toolbox-title">
  <h2 id="about-toolbox-title" class="text-[17px] font-semibold tracking-[-.01em] text-ink">Ma boîte à outils</h2>

  <ul class="mt-3 flex flex-wrap gap-2">
    {
      items.map(({ name, logo }) => (
        <li
          class="inline-flex max-w-full items-center gap-1.5 rounded-pill border border-line bg-chip px-3 py-1 font-mono text-[12px] break-words text-body"
          data-toolbox-item
        >
          {logo && (
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="currentColor"
              class="shrink-0"
              aria-hidden="true"
              focusable="false"
            >
              <path d={logo.path} />
            </svg>
          )}
          {name}
        </li>
      ))
    }
  </ul>
</section>
