---
/**
 * RelatedPosts.astro (plan 13, T4 ; inventaire §2 ; prototype 264–276) — la
 * fin du rail gauche d'un article, posée dans le slot de BlogRail
 * (`variant="links"`), après les Tags :
 *
 * - `<hr>` (marge 2/8, `line`) ;
 * - « Articles liés » : libellé mono 10 capitales `muted` et badge 22×22
 *   rayon 7 `badgeBg` / `badgeInk` (icône `file-text`) à droite, puis
 *   jusqu'à 3 cartes (écart 8) — `.card-inner` rayon 12, padding 12 :
 *   catégorie mono 10 `accent`, titre 13 / 500 / 1.35 `ink`, `date · N min`
 *   mono 10 `muted` (le prototype dit `dim`, D71). Bloc omis sans article lié
 *   (D86) ;
 * - `Plus d'articles →` 13 / 600 `accent` → `/blog/`, toujours présent.
 *
 * `data-related-posts` est lu par scripts/check-article.mjs.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';
import { estimateReadingMinutes } from '../../lib/posts';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const LABEL = 'font-mono text-[10px] tracking-[.12em] text-muted uppercase';
const dateFr = (date: Date) => date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<hr class="mx-2 my-0.5 border-line" />

<div class="flex flex-col gap-2">
  {
    posts.length > 0 && (
      <section aria-labelledby="article-related-posts" class="flex flex-col gap-3" data-related-posts>
        <div class="flex items-center gap-2 px-2">
          <p id="article-related-posts" class:list={['min-w-0 flex-1', LABEL]}>
            Articles liés
          </p>
          <span class="inline-flex size-[22px] shrink-0 items-center justify-center rounded-small bg-badgeBg text-badgeInk">
            <Icon name="file-text" size={13} />
          </span>
        </div>
        <ul class="flex flex-col gap-2">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}/`}
                class="group card-inner flex flex-col gap-[5px] rounded-nested p-3"
              >
                <span class="font-mono text-[10px] text-accent">{post.data.category}</span>
                <span class="font-sans text-[13px] leading-[1.35] font-medium text-pretty text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </span>
                <span class="font-mono text-[10px] text-muted">
                  <time datetime={post.data.pubDate.toISOString()}>{dateFr(post.data.pubDate)}</time> ·{' '}
                  {estimateReadingMinutes(post.body ?? '')} min
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <a href="/blog/" class="mt-0.5 self-start px-1 font-sans text-[13px] font-semibold text-accent hover:underline">
    Plus d'articles →
  </a>
</div>
