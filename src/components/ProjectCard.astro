---
/**
 * ProjectCard.astro — carte de la grille /projets (plan 14, T4 ; inventaire
 * §3, prototype 344–431, D92).
 *
 * Un `.card` (surface, rayon 20) posé sur le fond de page — plus de cadre
 * englobant ni de `.card-inner` (D67 remplace D51 sur cette liste). Padding
 * 8/8/22, écart 14 : vignette `tile` (120 px, rayon 14, `data-rail`, sans
 * monogramme) avec la pilule de statut incrustée en bas à gauche (12 px) ;
 * puis, en retrait de 14 px, titre h2 18 / 600, description 13 `muted`,
 * technos (rayon 7, padding 3/8, `chip`, mono 10 `muted`).
 *
 * Le lien du titre est étiré sur toute la carte (`after:inset-0`) : une
 * seule cible, aucun lien imbriqué. Survol : titre `accent`.
 */
import type { CollectionEntry } from 'astro:content';
import { PROJECT_STATUS_META } from '../lib/projectStatus';
import { projectFacets } from '../lib/projectFilters';
import Thumbnail from './Thumbnail.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Masquée côté serveur — la même entrée est déjà rendue dans le héros. */
  hidden?: boolean;
  /**
   * Vrai sur l'entrée que le serveur a RÉELLEMENT désignée via
   * `pickFeaturedEntry()` (spec §6.1). Pilote `data-featured` (fix 3, revue
   * finale de Plan 7).
   */
  isFeaturedEntry?: boolean;
}

const { project, hidden = false, isFeaturedEntry = false } = Astro.props;
const { title, description, status, stack, cover, coverAlt } = project.data;
const statusMeta = PROJECT_STATUS_META[status];
const facets = JSON.stringify(projectFacets({ status, stack }));
---

{/*
  Contrat de carte commun aux listes (Plan 7 / I4), lu par
  src/scripts/list-pattern.ts. `data-facet` est du JSON : aucune valeur de
  facette ne peut casser le parsing. `data-featured` reflète le choix RÉEL du
  serveur (`isFeaturedEntry`).
*/}
<article
  class="card group relative flex flex-col gap-3.5 px-2 pt-2 pb-[22px]"
  data-entry-id={project.id}
  data-facet={facets}
  data-date={project.data.startDate?.getTime() ?? 0}
  data-minutes={0}
  data-featured={isFeaturedEntry ? '' : undefined}
  hidden={hidden}
>
  <div class="relative">
    <Thumbnail cover={cover} coverAlt={coverAlt} title={title} derivedFrom={status} size="tile" />
    <span
      class={`absolute bottom-3 left-3 rounded-pill border px-[11px] py-[5px] font-mono text-[11px] leading-none ${statusMeta.chipClass}`}
      data-card-status
    >
      {statusMeta.label}
    </span>
  </div>

  <h2 class="px-3.5 font-sans text-lg leading-snug font-semibold text-ink transition-colors group-hover:text-accent">
    <a href={`/projets/${project.id}/`} class="after:absolute after:inset-0 after:rounded-card">{title}</a>
  </h2>

  <p class="px-3.5 text-[13px] leading-normal text-muted">{description}</p>

  {
    stack.length > 0 && (
      <ul class="flex flex-wrap gap-1.5 px-3.5" aria-label="Technologies">
        {stack.map((tech) => (
          <li class="rounded-small bg-chip px-2 py-[3px] font-mono text-[10px] text-muted" data-card-stack>
            {tech}
          </li>
        ))}
      </ul>
    )
  }
</article>
