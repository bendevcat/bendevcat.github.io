---
import type { AiUsage } from '../lib/aiUsage';
import { AI_USAGE_META } from '../lib/aiUsage';

interface Props {
  usage: AiUsage;
  /**
   * Nom accessible de la bannière. Par défaut, celui d'une bannière posée sur
   * un article — le cas de très loin le plus fréquent. La page
   * /transparence-ia rend ces bannières hors de tout article, pour illustrer
   * les 3 niveaux : elle passe donc son propre libellé, sinon un lecteur
   * d'écran y entendrait trois fois « de cet article » sur une page qui n'en
   * est pas un.
   */
  ariaLabel?: string;
  /**
   * Marge externe. Par défaut `mb-8`, l'espacement sous la bannière d'un
   * article ; /transparence-ia la pose dans un `.card-inner` et passe la
   * sienne.
   */
  class?: string;
}

const { usage, ariaLabel = 'Transparence IA de cet article', class: margin = 'mb-8' } = Astro.props;
const meta = AI_USAGE_META[usage];
---

{/* `data-ai-usage` + `data-tone` : le niveau et son ton (D40), lus par
    scripts/check-secondary.mjs (R7) — les couleurs, elles, viennent de
    `meta.bannerClass` (TONE_CLASSES). */}
<div
  class={`${margin} flex items-start gap-3 rounded-card border px-4 py-3 ${meta.bannerClass}`}
  role="note"
  aria-label={ariaLabel}
  data-ai-usage={usage}
  data-tone={meta.tone}
>
  <span class="text-lg leading-none" aria-hidden="true">{meta.emoji}</span>
  <div class="text-sm">
    <p class="font-mono text-xs font-semibold uppercase tracking-wide">{meta.label}</p>
    <p class="mt-1">{meta.description}</p>
    <p class="mt-2">
      <a href="/transparence-ia/" class="underline underline-offset-2 hover:no-underline">
        Comment je déclare l'usage de l'IA
      </a>
    </p>
  </div>
</div>
