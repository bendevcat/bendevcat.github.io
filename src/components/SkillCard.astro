---
import type { CollectionEntry } from 'astro:content';
import Thumbnail from './Thumbnail.astro';

interface Props {
  skill: CollectionEntry<'skills'>;
  /** Variante « à la une » : carte large, vignette en 16/7. */
  featured?: boolean;
  /** Masquée côté serveur — la même entrée est déjà rendue dans le bloc à la une. */
  hidden?: boolean;
  /**
   * Vrai sur l'entrée que le serveur a RÉELLEMENT désignée via
   * `pickFeaturedEntry()` (spec §6.1) — indépendant de `featured`, qui ne
   * pilote que la mise en page. Pilote `data-featured` (fix 3, revue finale).
   */
  isFeaturedEntry?: boolean;
}

const { skill, featured = false, hidden = false, isFeaturedEntry = false } = Astro.props;
const { title, description, type, version, tags } = skill.data;

// Même contrat que PromptCard.astro, lu par src/scripts/list-pattern.ts.
const facets = JSON.stringify({ type: [type], tag: tags });
---

{/*
  `data-featured` reflète le choix RÉEL du serveur (`isFeaturedEntry`) : le
  schéma `skills` n'a pas de champ `featured` (état mesuré du plan), donc sans
  cet attribut explicite le client ne pouvait retrouver l'entrée à la une que
  par coïncidence d'ordre — fix 3, revue finale de Plan 7.
*/}
<a
  href={`/skills/${skill.id}/`}
  class:list={[
    'group flex flex-col gap-3 rounded-card border border-line bg-surface p-4 transition-colors hover:border-accent/50',
    featured && 'sm:col-span-2 lg:col-span-3',
  ]}
  data-entry-id={skill.id}
  data-facet={facets}
  data-date={0}
  data-minutes={0}
  data-featured={isFeaturedEntry ? '' : undefined}
  hidden={hidden}
>
  <Thumbnail title={title} derivedFrom={type} size={featured ? 'featured' : 'card'} />

  <div class="flex flex-wrap items-center gap-2">
    <span class="w-fit rounded-pill border border-line px-2 py-0.5 font-mono text-xs text-muted">
      {type}
    </span>
    {
      version && (
        <span class="w-fit rounded-pill border border-line px-2 py-0.5 font-mono text-xs text-muted">
          v{version}
        </span>
      )
    }
  </div>

  <h3 class="font-sans text-lg font-semibold text-ink group-hover:text-accent">
    {title}
  </h3>

  <p class="text-sm text-muted">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label="Tags">
        {tags.map((tag) => (
          <li class="rounded-pill border border-line px-2 py-0.5 font-mono text-xs text-muted">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</a>
