---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Image du contenu, quand la collection en a une (blog, projects). */
  cover?: ImageMetadata;
  coverAlt?: string;
  /**
   * Repli du texte alternatif quand `coverAlt` est absent — `coverAlt` est
   * `optional()` dans les deux schémas. `ProjectCard` et l'ancienne carte d'article
   * faisaient déjà `alt={coverAlt ?? title}` AVANT ce plan : cette prop est ce
   * qui empêche de perdre ce repli en déménageant l'image ici. Requise, pour
   * que l'oubli soit impossible et non simplement improbable.
   */
  title: string;
  /** Chaîne dont le visuel dérivé est tiré : catégorie, statut ou type. */
  derivedFrom: string;
  /**
   * Format de la vignette (requis). Les tailles `card` et `featured` des
   * anciennes grilles /projets, /prompts et /skills ont disparu avec elles
   * (plan 14, T5 : /prompts et /skills n'ont plus de vignette).
   * Ajouts Plan 9 (accueil, D34) :
   * - `header` = image d'en-tête de la carte « à la une » de l'accueil, 196 px
   *   de haut, rayon 14 px (contrat §3.2 : « image d'en-tête ») ;
   * - `square` = vignette carrée 72 px des « Derniers articles », rayon 10 px.
   * Ajout Plan 12 (T5) :
   * - `row` = vignette 76×64, rayon 10 px, des lignes compactes de /blog
   *   (prototype 163–227). Son visuel dérivé repose directement sur `surface`
   *   (la ligne ne peint aucun fond) : il porte `data-rail`, l'exemption V2
   *   des rails explicites (D74).
   * Ajouts Plan 14 (T4, /projets — prototype 344–431, D92) :
   * - `tile` = vignette de carte de grille, 120 px de haut, rayon 14 ;
   * - `hero` = colonne visuelle du héros, 300 px de haut au moins (180 sous
   *   768 px, empilé), sans rayon propre (la carte rogne ses coins).
   *   Les deux reposent directement sur la carte (`surface`) : leur visuel
   *   dérivé porte `data-rail` (D74), sans monogramme, avec la trame du
   *   prototype (`0 2px / 2px 12px`, ligne 377).
   * Ajout Plan 15 (T5, fiche projet — prototype 433–522) :
   * - `banner` = bandeau du haut de la carte principale, 150 px de haut,
   *   pleine largeur, sans rayon propre (la carte rogne ses coins) ; même
   *   trame nue que `tile` / `hero`, avec `data-rail` (il repose sur `surface`).
   */
  size: 'header' | 'square' | 'row' | 'tile' | 'hero' | 'banner';
  /**
   * Couverture au-dessus de la ligne de flottaison (les deux entrées « à la
   * une » : accueil et /blog) : `loading="eager"`. Toutes les autres restent
   * `lazy`, le défaut d'`<Image>` (plan 11, R12).
   */
  eager?: boolean;
}

const { cover, coverAlt, title, derivedFrom, size, eager = false } = Astro.props;

// R8 / spec §6.1 : sans `cover`, le visuel est DÉRIVÉ — aucun fichier image,
// aucun champ de schéma. Le monogramme est purement fonction de la chaîne, donc
// stable d'un build à l'autre.
const monogram = derivedFrom.slice(0, 2).toUpperCase();

// Cadre par taille : format, largeur, rayon.
const FRAME: Record<Props['size'], { box: string; width: string; radius: string }> = {
  header: { box: 'h-[196px]', width: 'w-full', radius: 'rounded-inner' },
  square: { box: 'size-[72px]', width: 'shrink-0', radius: 'rounded-thumb' },
  row: { box: 'h-16', width: 'w-[76px] shrink-0', radius: 'rounded-thumb' },
  tile: { box: 'h-[120px]', width: 'w-full', radius: 'rounded-inner' },
  hero: { box: 'h-full min-h-[180px] md:min-h-[300px]', width: 'w-full', radius: '' },
  banner: { box: 'h-[150px]', width: 'w-full', radius: '' },
};
const { box, width: frameWidth, radius } = FRAME[size];
// La vignette carrée s'affiche en 72×72 (object-cover) : on ne livre pas
// l'original pleine taille pour si peu. On fixe le PETIT côté à 144 px (2×
// pour les écrans denses), l'autre suit le ratio — fixer la largeur d'une
// image paysage ne laisserait que 72 px de haut, soit du 1×.
const squareSide = 144;
const landscape = cover ? cover.width >= cover.height : true;
// Vignette de ligne 76×64 : même raisonnement, cadre non carré — l'image est
// servie en 2× (152×128) sur le côté qui contraint le recadrage.
const ROW = { width: 152, height: 128 };
const widerThanRow = cover ? cover.width / cover.height >= ROW.width / ROW.height : true;
const width =
  size === 'square' && !landscape ? squareSide : size === 'row' && !widerThanRow ? ROW.width : undefined;
const height =
  size === 'square' && landscape ? squareSide : size === 'row' && widerThanRow ? ROW.height : undefined;
// Monogramme à l'échelle du cadre : `text-2xl` déborderait presque du carré 72 px.
const monogramSize = size === 'square' || size === 'row' ? 'text-base' : 'text-2xl';
// Plan 14 : les visuels de /projets (`tile`, `hero`) sont une trame nue, sans
// monogramme, à la trame du prototype ; ils reposent sur la carte, d'où
// `data-rail` (comme `row`). Plan 15 : le bandeau de fiche (`banner`) aussi.
const bare = size === 'tile' || size === 'hero' || size === 'banner';
const hatch = bare
  ? 'repeating-linear-gradient(135deg, var(--color-hatch) 0 2px, transparent 2px 12px)'
  : 'repeating-linear-gradient(135deg, var(--color-hatch) 0 1px, transparent 1px 9px)';
const explicitRail = size === 'row' || bare;
---

{
  cover ? (
    <Image
      src={cover}
      alt={coverAlt ?? title}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      class={`${box} ${frameWidth} ${radius} object-cover`}
    />
  ) : (
    /*
      Niveau 4 de la hiérarchie des surfaces (§2.1) : `rail` est le creux — il
      est posé ici DANS une carte, jamais directement sur `surface` (V2).
      `hatch` fournit la trame ; les deux tokens ne peignaient rien avant ce
      plan (spec §6.4).
    */
    <div
      class={`${box} flex ${frameWidth} items-center justify-center ${radius} bg-rail`}
      style={`background-image: ${hatch};`}
      aria-hidden="true"
      data-thumb-derived
      data-rail={explicitRail ? '' : undefined}
    >
      {!bare && <span class={`font-mono ${monogramSize} font-medium tracking-[.06em] text-muted`}>{monogram}</span>}
    </div>
  )
}
