---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<html lang="fr">
  <head>
    <script is:inline>
      document.documentElement.dataset.js = ''; // D11 : repli sans JS des onglets (global.css)
      (() => {
        const stored = localStorage.getItem('theme');
        const theme = stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Header />
    {/*
      Coque (plan 12, R1) : le contenu de chaque page est plafonné à 1180 px
      et porte le padding horizontal de la coque (16 px, 24 px dès 640 px).
      `box-content` (F1) : le plafond vaut pour la boîte de contenu, le padding
      s'y ajoute, comme le `max-width:1180px` du prototype — à 1280 px le
      contenu fait 1180 px en x 50–1230. Sous 1228 px la largeur reste `auto`
      (viewport − padding), donc pas de débordement à 375 px.
      Une `div` et pas un `<main>` : les pages rendent leur propre `<main>`.
    */}
    <div data-shell="main" class="mx-auto box-content max-w-shell px-4 sm:px-6">
      <slot />
    </div>
    <Footer />
    <SearchDialog />
    <script>
      import '../scripts/search.ts';
    </script>
  </body>
</html>
