---
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import TagChip from '../../components/TagChip.astro';
import { getSortedPrompts } from '../../lib/prompts';
import { sortAndFilterSkills } from '../../lib/skills';
import { assertEntriesResolved } from '../../lib/references';
import { shouldRenderPromptBlock } from '../../lib/promptView';
import { promptTabs } from '../../lib/detailTabs';

export async function getStaticPaths() {
  const prompts = await getSortedPrompts();
  return prompts.map((prompt) => ({ params: { slug: prompt.id }, props: { prompt } }));
}

const { prompt } = Astro.props;
const { Content } = await render(prompt);
const { title, description, format, tool, model, tags } = prompt.data;

const showPromptBlock = shouldRenderPromptBlock(format, prompt.data.prompt);

// ADDITION n°2 (ratifiée au gate) : sens prompt → skills. R6/R7 n'exigent que
// le sens skill → prompts ; sans ceci, `relatedSkills` serait un champ de
// données jamais affiché. `assertEntriesResolved` fait échouer le build avec
// un message nommant l'entrée et l'id manquant plutôt que de laisser passer
// un `undefined` (D06, Plan 3) — appelé EN PREMIER, sinon une référence
// cassée serait masquée.
// `sortAndFilterSkills` (src/lib/skills.ts) est composé ENSUITE : il écarte
// les skills `draft` (référence valide, mais pas de route publique — les
// lier produirait un 404) et trie A→Z. D09 (fix round 1, T-C2) : réutilise le
// helper testé existant au lieu de réécrire le filtre à la main, qui perdait
// le tri (cf. sortAndFilterPrompts, composé symétriquement côté skill →
// prompts).
const relatedSkills = prompt.data.relatedSkills?.length
  ? sortAndFilterSkills(
      assertEntriesResolved(
        prompt.id,
        prompt.data.relatedSkills,
        await getEntries(prompt.data.relatedSkills),
      ),
    )
  : [];

// Plan 8 : QUELS onglets existent se décide dans src/lib/detailTabs.ts —
// jamais ici. Le corps, fiche ou guide, nourrit « Pourquoi » (D3) ; « Infos »
// est toujours là (format et tool ont des valeurs par défaut). Le bloc du
// prompt, lui, reste AU-DESSUS des onglets (D6) : c'est l'action principale.
const tabs = promptTabs({ body: prompt.body });
const shown = new Set(tabs.map((tab) => tab.id));
---

<BaseLayout title={`${title} — bencat_`} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-10" data-pagefind-body>
    <p class="font-mono text-sm text-accent">~/ prompts</p>

    <h1 class="mt-4 font-sans text-4xl font-bold text-ink">{title}</h1>

    <p class="mt-4 text-muted">{description}</p>

    {
      showPromptBlock && (
        <section class="mt-10">
          <h2 class="font-mono text-sm text-muted">// le prompt</h2>
          {/*
            Correctif D07 (pending-user, cheap) : le Step 6 d'origine rendait
            ce <pre> hors de tout `.prose`, or la règle `.prose :where(pre)`
            de src/styles/global.css — overflow-x:auto, padding,
            bordure, rayon — est SCOPÉE à `.prose`. Résultat mesuré au smoke
            navigateur : overflow-x:visible, padding/border/radius à 0,
            2461px de débordement horizontal à 375px (R9 cassée) et aucun
            style du composant code-block du Plan 1 appliqué (spec §6.2).

            Fix : on place le <pre> dans un conteneur `.prose`, exactement
            comme le corps (panneau « Pourquoi ») ci-dessous — on RÉUTILISE
            `.prose :where(pre)`, on ne duplique aucune règle CSS et on ne
            touche pas à src/styles/global.css. Le label « // le prompt »
            reste hors de `.prose`, comme les titres de repli des onglets :
            `.prose :where(h2)` (police display, 1.5rem) écraserait sinon
            son style de label mono discret.

            Correctif addendum D07 (revue qualité, round 1) : ce <pre> ne
            porte PAS la classe `astro-code`. Une première version l'ajoutait
            en pensant que `.prose { font-family: var(--font-sans) }`
            (règle `.prose` de global.css) écraserait sinon la police mono par héritage — c'est
            faux : une valeur héritée ne concurrence JAMAIS une règle qui
            matche l'élément directement, et le preflight Tailwind v4 déclaré
            en tête de ce fichier (`@import "tailwindcss"`) fait déjà
            `code, kbd, samp, pre { font-family: --theme(--default-mono-
            font-family, …) }`, qui se résout à `var(--font-mono)` via
            `--font-mono` (notre `@theme`) — donc ce <pre> est en JetBrains
            Mono sans rien ajouter. Pire : `astro-code` n'est pas neutre —
            la règle `.astro-code` de global.css lui impose un fond
            `background-color: var(--color-code) !important` (garde-fou du
            thème Shiki tiré des tokens, plan 11), étranger à ce bloc. (Avant
            le plan 11, c'étaient 5 déclarations `!important` de bascule
            sombre de Shiki, retirées depuis.) Vérifié sur le HTML buildé et en dev :
            `getComputedStyle(pre).fontFamily` reste bien
            `"JetBrains Mono Variable", ui-monospace, …` sans la classe.

            R3 : ce <pre> reste DANS <article> (juste un niveau plus profond,
            via .prose puis .code-block-wrapper), donc
            src/scripts/copy-code.ts (importé plus bas) lui accroche toujours
            son bouton « Copier »/« Copié ! ». Aucun second mécanisme de
            copie — spec §6.2.
          */}
          <div class="prose mt-4">
            <pre><code>{prompt.data.prompt}</code></pre>
          </div>
        </section>
      )
    }

    {/*
      Plan 8 (D7) : format, outil, modèle, tags et skills liés quittent
      l'en-tête pour le panneau « Infos » — les afficher aux deux endroits
      rendrait Infos redondant.
    */}
    <DetailTabs tabs={tabs} label="Sections du prompt">
      {
        shown.has('pourquoi') && (
          <div slot="pourquoi" class="prose">
            <Content />
          </div>
        )
      }

      {
        shown.has('infos') && (
          <dl slot="infos" class="grid gap-x-6 gap-y-2 font-mono text-xs sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-y-4">
            <dt class="text-muted">format</dt>
            <dd class="mb-2 sm:mb-0">
              <span class="rounded-pill border border-line px-2 py-0.5 text-muted">{format}</span>
            </dd>

            <dt class="text-muted">outil</dt>
            <dd class="mb-2 sm:mb-0">
              <span class="rounded-pill border border-line px-2 py-0.5 text-muted">{tool}</span>
            </dd>

            {model && (
              <>
                <dt class="text-muted">modèle</dt>
                <dd class="mb-2 sm:mb-0">
                  <span class="rounded-pill border border-line px-2 py-0.5 text-muted">{model}</span>
                </dd>
              </>
            )}

            {tags.length > 0 && (
              <>
                <dt class="text-muted">tags</dt>
                <dd class="mb-2 sm:mb-0">
                  <ul class="flex flex-wrap gap-2" aria-label="Tags">
                    {tags.map((tag) => (
                      <TagChip tag={tag} />
                    ))}
                  </ul>
                </dd>
              </>
            )}

            {relatedSkills.length > 0 && (
              <>
                <dt class="text-muted">skills liés</dt>
                <dd class="min-w-0">
                  <ul class="flex flex-col gap-2 font-sans text-base">
                    {relatedSkills.map((skill) => (
                      <li>
                        <a
                          href={`/skills/${skill.id}/`}
                          class="text-body underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
                        >
                          {skill.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </>
            )}
          </dl>
        )
      }
    </DetailTabs>
  </article>

  <script>
    import '../../scripts/copy-code.ts';
  </script>
</BaseLayout>
