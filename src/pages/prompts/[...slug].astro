---
/**
 * Fiche prompt (plan 16, T5 ; inventaire §6 ; prototype 582–736 ; D111).
 *
 * `<main>` › `<article data-pagefind-body>`, 40 px sous le header du site :
 * l'en-tête (PromptHeader, sans carte), puis, 28 px dessous, une grille — à
 * partir de 1024 px `minmax(0,1fr) | 340px`, écart 22 ; en dessous une
 * colonne, fenêtre puis colonne latérale (ordre du DOM).
 *
 * - Fenêtre (PromptWindow) : le texte que mesure la carte de `/prompts/`
 *   (measurePromptText) — le `prompt` d'une fiche qui en a un, variables à
 *   leur défaut, sinon le corps. En-tête, barre et carte partagent ses comptes.
 * - Colonne `<aside aria-label="Autour du prompt">`, écart 12 : onglets en
 *   piste (DetailTabs `variant="track"`) variables · décryptage · infos — un
 *   onglet sans données est omis (promptPageTabs, src/lib/detailTabs.ts) ;
 *   puis Skills liés et Prompts liés (src/lib/promptDetail.ts), chacune omise
 *   quand elle est vide.
 * - Le corps d'une fiche nourrit `décryptage` (prose, indexée) ; celui d'un
 *   guide est dans la fenêtre. Pas de `sortie` : aucun champ ne la nourrit.
 *
 * Crochets lus par scripts/check-prompt.mjs : `data-prompt-aside` et ceux des
 * composants de src/components/prompt/.
 */
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditLink from '../../components/EditLink.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import PromptHeader from '../../components/prompt/PromptHeader.astro';
import PromptWindow from '../../components/prompt/PromptWindow.astro';
import PromptVariables from '../../components/prompt/PromptVariables.astro';
import PromptInfos from '../../components/prompt/PromptInfos.astro';
import RelatedSkillsCard from '../../components/prompt/RelatedSkillsCard.astro';
import RelatedPromptsCard from '../../components/prompt/RelatedPromptsCard.astro';
import { getSortedPrompts } from '../../lib/prompts';
import { sortSkills } from '../../lib/skills';
import { assertEntriesResolved } from '../../lib/references';
import { promptPageTabs } from '../../lib/detailTabs';
import { measurePromptText, promptStats } from '../../lib/listCards';
import { promptWindowSource } from '../../lib/promptWindow';
import { promptMetaSlots, relatedPromptIds, relatedSkillIds } from '../../lib/promptDetail';
import { tagSlug } from '../../lib/tags';

export async function getStaticPaths() {
  const prompts = await getSortedPrompts();
  return prompts.map((prompt) => ({ params: { slug: prompt.id }, props: { prompt, prompts } }));
}

const { prompt, prompts } = Astro.props;
const { Content } = await render(prompt);
const { title, description, format, tool, model, tags, updated } = prompt.data;

// D06 : une référence `relatedSkills` cassée fait échouer le build en nommant
// le prompt et l'id manquant, au lieu de disparaître en silence.
if (prompt.data.relatedSkills?.length) {
  assertEntriesResolved(prompt.id, prompt.data.relatedSkills, await getEntries(prompt.data.relatedSkills));
}

// Skills liées : déclarées d'abord, puis celles dont `relatedPrompts` liste le
// prompt ; publiées seulement (relatedSkillIds écarte les brouillons).
const allSkills = sortSkills(await getCollection('skills'));
const skillInputs = allSkills.map((skill) => ({
  id: skill.id,
  draft: skill.data.draft,
  relatedPrompts: skill.data.relatedPrompts,
}));
const skillsById = new Map(allSkills.map((skill) => [skill.id, skill]));
const skillIdsOf = (entry: typeof prompt) => relatedSkillIds(entry.id, entry.data.relatedSkills, skillInputs);
const relatedSkills = skillIdsOf(prompt).map((id) => skillsById.get(id)!);

// Prompts liés : skill liée ou tag en commun (clés `tagSlug`), 3 au plus.
const relationOf = (entry: typeof prompt) => ({
  id: entry.id,
  title: entry.data.title,
  draft: entry.data.draft,
  skillIds: skillIdsOf(entry),
  tagKeys: entry.data.tags.map(tagSlug),
});
const promptsById = new Map(prompts.map((entry) => [entry.id, entry]));
const relatedPrompts = relatedPromptIds(relationOf(prompt), prompts.map(relationOf)).map(
  (id) => promptsById.get(id)!,
);

// Fenêtre et comptes : un seul texte (measurePromptText), aux défauts.
const source = promptWindowSource(prompt.data, prompt.body);
const windowText = measurePromptText(prompt.data, prompt.body);
const meta = promptMetaSlots(prompt.data, promptStats(windowText));

// QUELS onglets existent se décide dans src/lib/detailTabs.ts.
const tabs = promptPageTabs({
  variableCount: source.variables.length,
  windowShowsPrompt: source.showsPrompt,
  body: prompt.body,
});
const shown = new Set(tabs.map((tab) => tab.id));
const origin = relatedSkills[0] ? { id: relatedSkills[0].id, title: relatedSkills[0].data.title } : null;

// Prose du décryptage à 14 px, h2 16 / 600 : `.prose` (global.css) est hors
// couche et l'emporterait sur un utilitaire simple — d'où le `!`.
const DECRYPTAGE =
  'prose [&_ol]:text-[14px]! [&_p]:text-[14px]! [&_ul]:text-[14px]! [&_h2]:mt-6! [&_h2]:mb-2! [&_h2]:text-base! [&_h2]:font-semibold! [&>:first-child]:mt-0!';
---

<BaseLayout title={`${title} — bencat_`} description={description}>
  <main>
    <article data-pagefind-body class="pt-10">
      <PromptHeader
        title={title}
        description={description}
        format={format}
        tool={tool}
        model={model}
        meta={meta}
        updated={updated}
      />

      <div class="mt-7 grid grid-cols-1 gap-[22px] lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
        <PromptWindow
          id={prompt.id}
          template={source.template}
          variables={source.variables}
          text={windowText}
          counts={meta.windowCounts}
        />

        <aside aria-label="Autour du prompt" class="flex min-w-0 flex-col gap-3" data-prompt-aside>
          <DetailTabs tabs={tabs} label="Sections du prompt" variant="track">
            {
              shown.has('variables') && (
                <div slot="variables">
                  <PromptVariables variables={source.variables} />
                </div>
              )
            }

            {
              shown.has('decryptage') && (
                <div slot="decryptage" class={DECRYPTAGE} data-prompt-notes>
                  <Content />
                </div>
              )
            }

            {
              shown.has('infos') && (
                <div slot="infos">
                  <PromptInfos
                    format={format}
                    tool={tool}
                    model={model}
                    length={meta.headerCounts}
                    versionDate={meta.versionDate}
                    tags={tags}
                    origin={origin}
                  />
                </div>
              )
            }
          </DetailTabs>

          {
            relatedSkills.length > 0 && (
              <RelatedSkillsCard
                skills={relatedSkills.map((skill) => ({
                  id: skill.id,
                  title: skill.data.title,
                  version: skill.data.version,
                  description: skill.data.description,
                }))}
              />
            )
          }

          {
            relatedPrompts.length > 0 && (
              <RelatedPromptsCard
                prompts={relatedPrompts.map((entry) => ({
                  id: entry.id,
                  title: entry.data.title,
                  format: entry.data.format,
                  tool: entry.data.tool,
                }))}
              />
            )
          }
        </aside>
      </div>
    </article>
    <EditLink collection={prompt.collection} id={prompt.id} />
  </main>

  <script>
    import '../../scripts/copy-code.ts';
  </script>
</BaseLayout>
