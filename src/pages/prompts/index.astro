---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';
import { getSortedPrompts, collectTools, collectPromptTags } from '../../lib/prompts';
import { PROMPT_FORMATS } from '../../content.config';
import { ALL } from '../../lib/facetFilters';
import { pickFeaturedEntry } from '../../lib/listPattern';

// getSortedPrompts() applique déjà l'ordre du plan (titre A→Z) et écarte les
// `draft` — cf. src/lib/prompts.ts. Pas de re-tri ici.
const prompts = await getSortedPrompts();
const tools = collectTools(prompts);
const tags = collectPromptTags(prompts);

// Même règle de dérivation que src/scripts/list-pattern.ts (spec §6.1,
// décision I3) : l'entrée à la une est désignée CÔTÉ SERVEUR, pour que la
// carte « à la une » et sa copie masquée dans la grille pointent exactement
// vers la même entrée que computeListState() désignerait sans filtre. Ni
// `prompts` ni `skills` n'ont de champ `featured` (état mesuré du plan) :
// pickFeaturedEntry() retombe donc systématiquement sur la première entrée de
// l'ordre canonique.
const featured = pickFeaturedEntry(prompts);

// Source unique du vocabulaire : sert `data-list-nouns` ET le repli SSR de la
// ligne de méta (accord singulier/pluriel), pour que les deux ne divergent
// jamais.
const NOUNS = ['prompt', 'prompts'] as const;
---

<BaseLayout
	title="Prompts — bencat_"
	description="La bibliothèque de prompts de bencat_ : fiches copiables et guides."
>
	<main>
		<section class="py-16">
			<p class="font-mono text-sm text-accent">~/ prompts</p>
			<h1 class="mt-4 font-sans text-4xl font-bold text-ink sm:text-5xl">Prompts</h1>
		</section>

		<section class="pb-20" data-list data-list-nouns={NOUNS.join('|')}>
			{/* 1 · pilules de filtre (tool) + 2 · dropdowns (format, tag) — `hidden` côté serveur (contrainte n°5) */}
			<div
				class="mb-6 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between"
				data-list-filters
				hidden
			>
				<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrer par outil">
					<button
						type="button"
						data-facet-key="tool"
						data-facet-label="outil"
						data-facet-value={ALL}
						aria-pressed="true"
						class="rounded-pill border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent"
					>
						tous
					</button>
					{
						tools.map((tool) => (
							<button
								type="button"
								data-facet-key="tool"
								data-facet-label="outil"
								data-facet-value={tool}
								aria-pressed="false"
								class="rounded-pill border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent"
							>
								{tool}
							</button>
						))
					}
				</div>

				<div class="flex flex-wrap items-center gap-4">
					<label class="flex items-center gap-2 font-mono text-xs text-muted">
						format
						<select
							data-facet-key="format"
							data-facet-label="format"
							class="rounded-pill border border-line bg-surface px-2 py-1 font-mono text-xs text-body"
						>
							<option value={ALL}>tous</option>
							{PROMPT_FORMATS.map((format) => <option value={format}>{format}</option>)}
						</select>
					</label>

					{
						tags.length > 0 && (
							<label class="flex items-center gap-2 font-mono text-xs text-muted">
								tag
								<select
									data-facet-key="tag"
									data-facet-label="tag"
									class="rounded-pill border border-line bg-surface px-2 py-1 font-mono text-xs text-body"
								>
									<option value={ALL}>tous</option>
									{tags.map((tag) => <option value={tag}>{tag}</option>)}
								</select>
							</label>
						)
					}
				</div>
			</div>

			{/* 3 · ligne de méta — donnée machine, donc mono (contrainte n°7). Région
			     live polie et atomique (plan 11, R6) : list-pattern.ts réécrit le texte
			     de CE nœud à chaque filtre, le lecteur d'écran annonce le nouveau
			     compte en entier. `muted` et non `dim` : `dim` sur `bg` = 4,19:1 en
			     clair (R8). */}
			<p class="mb-6 font-mono text-xs text-muted" data-list-meta aria-live="polite" aria-atomic="true">{prompts.length} {prompts.length <= 1 ? NOUNS[0] : NOUNS[1]}</p>

			{/* Cadre des entrées (plan 11, D51 — V2) : à la une, grille et état vide
			     dans UN `.card` (niveau `surface`), chaque carte d'entrée un
			     `.card-inner` (niveau `card`) — un seul niveau d'écart, comme
			     /tags/<tag> et la recherche. L'écart entre blocs est un `gap` : un
			     bloc `hidden` (à la une filtrée, état vide) n'en laisse aucun. Une
			     grille vide, elle, reste un élément flex et prendrait une place de
			     `gap` (l'état vide ne serait plus centré) : le script la rend `hidden`
			     dès qu'aucune carte n'y est visible (F2) ; le serveur jamais. */}
			<div class="card flex flex-col gap-6 p-4 sm:p-6" data-list-frame>
				{/* 4 · entrée à la une — UNE seule carte, désignée côté serveur (décision I3) */}
				<div data-list-featured>
					{featured && <PromptCard prompt={featured} featured isFeaturedEntry />}
				</div>

				{/* 5 · grille — contient TOUTES les entrées ; celle qui est déjà à la une est
				     rendue `hidden` PAR LE SERVEUR, pour que sans JavaScript la page montre
				     chaque entrée exactement une fois (contrainte globale n°5). */}
				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-list-grid>
					{
						prompts.map((prompt) => (
							<PromptCard
								prompt={prompt}
								hidden={prompt.id === featured?.id}
								isFeaturedEntry={prompt.id === featured?.id}
							/>
						))
					}
				</div>

				{/* 6 · état vide */}
				<div class="flex flex-col items-start gap-3" data-list-empty hidden>
					<p class="text-sm text-muted" data-list-empty-text></p>
					<button
						type="button"
						data-list-reset
						class="rounded-pill border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
					>
						voir tous les prompts
					</button>
				</div>
			</div>
		</section>

		<script>
			import '../../scripts/list-pattern.ts';
		</script>
	</main>
</BaseLayout>
