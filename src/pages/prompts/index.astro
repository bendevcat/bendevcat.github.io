---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListHeader from '../../components/ListHeader.astro';
import SegmentedControl from '../../components/SegmentedControl.astro';
import Dropdown from '../../components/Dropdown.astro';
import PromptCard from '../../components/PromptCard.astro';
import ListEmpty from '../../components/ListEmpty.astro';
import { getSortedPrompts, collectTools } from '../../lib/prompts';
import { PROMPT_FORMATS } from '../../content.config';
import { ALL } from '../../lib/facetFilters';
import { computeListState, facetCounts, type ListLabels } from '../../lib/listPattern';

// Plan 14, T5 (inventaire §5, prototype 524–580 ; D92–D94) : en-tête de
// liste, barre de filtres (format segmenté à gauche, menu outil à droite),
// puis une grille de cartes compactes posées sur le fond de page — ni
// vignette, ni entrée à la une, ni puces de tag, ni facette tag.

// getSortedPrompts() applique déjà l'ordre du plan (titre A→Z) et écarte les
// `draft` — cf. src/lib/prompts.ts. Pas de re-tri ici.
const prompts = await getSortedPrompts();
const tools = collectTools(prompts);

// Source unique du vocabulaire : `data-list-nouns` ET la méta serveur.
const NOUNS = ['prompt', 'prompts'] as const;

// Comptes statiques (D93) : chaque valeur comptée sur TOUS les prompts publiés.
const entries = prompts.map((prompt) => ({
	id: prompt.id,
	facets: { format: [prompt.data.format], tool: [prompt.data.tool] },
	featured: false,
	date: 0,
	minutes: 0,
}));
const FORMAT_LABELS: Record<(typeof PROMPT_FORMATS)[number], string> = {
	fiche: 'Fiche',
	guide: 'Guide',
};
const formatCounts = facetCounts(entries, 'format', [ALL, ...PROMPT_FORMATS]);
const formatSegments = [
	{ value: ALL, label: 'Tous', count: formatCounts[ALL] },
	...PROMPT_FORMATS.map((format) => ({ value: format, label: FORMAT_LABELS[format], count: formatCounts[format] })),
];
const toolCounts = facetCounts(entries, 'tool', [ALL, ...tools]);
const toolOptions = [
	{ value: ALL, label: 'tous', count: toolCounts[ALL] },
	...tools.map((tool) => ({ value: tool, label: tool, count: toolCounts[tool] })),
];

// Phrase d'état vide du prototype (D93) : un gabarit sans emplacement, donc
// la même quelles que soient les facettes actives.
const EMPTY_TEMPLATE = 'Aucun prompt ne correspond à ce filtre.';

// Méta serveur = premier texte calculé par le script (D57), par la MÊME
// fonction et les mêmes libellés que ceux que list-pattern.ts lit dans la
// barre (segments d'abord, puis menu).
const labels: ListLabels = {
	singular: NOUNS[0],
	plural: NOUNS[1],
	facets: [
		{ key: 'format', label: 'format' },
		{ key: 'tool', label: 'outil' },
	],
	emptyTemplate: EMPTY_TEMPLATE,
};
const rest = { format: ALL, tool: ALL };
const { meta } = computeListState(entries, rest, 'none', labels, { featured: false });
const emptyText = computeListState([], rest, 'none', labels, { featured: false }).empty ?? '';
---

<BaseLayout
	title="Prompts — bencat_"
	description="La bibliothèque de prompts de bencat_ : fiches copiables et guides."
>
	<main>
		<ListHeader path="prompts" title="Prompts" />

		<section data-list data-list-nouns={NOUNS.join('|')} data-list-empty-template={EMPTY_TEMPLATE}>
			{/* Barre de filtres, 22 px sous le h1 — `hidden` côté serveur, révélée par
			     le script (pas de contrôle mort sans JS). */}
			<div class="mt-[22px] flex flex-wrap items-center justify-between gap-5" data-list-filters hidden>
				<SegmentedControl
					facetKey="format"
					facetLabel="format"
					label="Filtrer par format"
					segments={formatSegments}
				/>
				<Dropdown
					label="outil"
					icon="filter"
					minWidth={230}
					options={toolOptions}
					selected={ALL}
					data-facet-key="tool"
					data-facet-label="outil"
				/>
			</div>

			{/* Ligne de méta — région live polie et atomique (plan 11, R6),
			     visuellement masquée : le prototype n'en dessine pas (D93). */}
			<p class="sr-only text-muted" data-list-meta aria-live="polite" aria-atomic="true">{meta}</p>

			{/* Contenu, 18 px sous la barre : grille puis état vide, sans cadre (D92). */}
			<div class="mt-[18px] flex flex-col gap-[18px]">
				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-list-grid>
					{prompts.map((prompt) => <PromptCard prompt={prompt} />)}
				</div>

				<ListEmpty icon="file-text" text={emptyText} resetLabel="réinitialiser les filtres →" />
			</div>
		</section>

		<script>
			import '../../scripts/list-pattern.ts';
		</script>
	</main>
</BaseLayout>
