---
import BaseLayout from '../layouts/BaseLayout.astro';
import Identity from '../components/about/Identity.astro';
import Terminal from '../components/about/Terminal.astro';
import AiPanel from '../components/about/AiPanel.astro';
import Toolbox from '../components/about/Toolbox.astro';
import { collectTagIndex, getTagBuckets } from '../lib/tags';
import { ABOUT_FACTS, collectStack, whoamiLines } from '../lib/about';

// Plan 10 — structure « à propos » du prototype (contrat E11, About map),
// nourrie UNIQUEMENT par ce que le dépôt contient déjà (D26, D42) : aucune
// phrase inventée (gate du 2026-09-04), aucune valeur de démo du prototype.
// Textes de l'auteur repris VERBATIM (R6) :
// - src/content/blog/bienvenue-dans-mon-foutoir/index.md, via l'ancienne
//   version de cette page (Qui je suis, Pourquoi ce site, la règle sur l'IA) ;
// - l'ancien Hero.astro (h1 et présentation), supprimé (D44).
// Registre : tutoiement, comme la spec de design §4.
//
// Données dérivées : les 4 collections publiées, chacune dans son ordre
// canonique (getTagBuckets : drafts écartés) → index des tags, comptes,
// stack des projets.
const buckets = await getTagBuckets();
const stack = collectStack(buckets.projects);
const lines = whoamiLines({
  ...ABOUT_FACTS,
  tags: collectTagIndex(buckets),
  counts: {
    articles: buckets.blog.length,
    projets: buckets.projects.length,
    prompts: buckets.prompts.length,
    skills: buckets.skills.length,
  },
  stack,
});
---

<BaseLayout
  title="À propos — bencat_"
  description="Benoît Catillon, alias benCat_ : ingénieur DevOps, et pourquoi ce site existe."
>
  <main class="flex flex-col gap-5 pt-6 pb-20 sm:pt-8">
    {/* Rangée 1 : identité (sur bg) et terminal, empilés en étroit, côte à côte en large. */}
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[1.35fr_1fr] lg:items-start">
      <Identity />
      <Terminal lines={lines} />
    </div>

    {/* Rangée 2 : deux `.card` sur bg, textes de l'auteur (le « On parle ? »
        du prototype n'a pas de canal réel ici, D42). */}
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2" data-about="row2">
      <section class="card min-w-0 p-4 sm:p-5" aria-labelledby="about-who-title">
        <h2 id="about-who-title" class="text-[17px] font-semibold tracking-[-.01em] text-ink">Qui je suis</h2>
        <p class="mt-2 text-[15px] leading-[1.6] text-body">
          Benoît Catillon, <strong>benCat_</strong> en ligne. Bientôt la quarantaine — mais je le
          vis bien. Ingénieur DevOps depuis 2019, en France. Passionné de tech, de geekerie en tout
          genre, de science-fiction et de manga, depuis toujours.
        </p>
      </section>

      <section class="card min-w-0 p-4 sm:p-5" aria-labelledby="about-why-title">
        <h2 id="about-why-title" class="text-[17px] font-semibold tracking-[-.01em] text-ink">Pourquoi ce site</h2>
        <p class="mt-2 text-[15px] leading-[1.6] text-body">
          Pour décharger mon cerveau : centraliser des idées, des réflexions, des snippets et des
          tutos en lien avec mon « vis ma vie » de DevOps — ou pas. J'espère bien réussir à garder
          cet espace aussi clean que possible, une sorte de base de données fun à utiliser.
        </p>
      </section>
    </div>

    <AiPanel />

    {stack.length > 0 && <Toolbox stack={stack} />}
  </main>
</BaseLayout>
