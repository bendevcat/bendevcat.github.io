---
import BaseLayout from '../layouts/BaseLayout.astro';
import AiBanner from '../components/AiBanner.astro';
import { AI_USAGE_META, type AiUsage } from '../lib/aiUsage';

// Ordre du plus humain au plus assisté — c'est l'échelle, pas l'ordre
// alphabétique.
const LEVELS: AiUsage[] = ['none', 'partial', 'full'];
---

<BaseLayout
  title="Transparence IA — bencat_"
  description="Comment bencat_ déclare le niveau de contribution IA de chaque article : les 3 niveaux, leur signalétique."
>
  <main>
    <section class="mx-auto max-w-3xl py-16">
      <p class="font-mono text-sm text-accent">~/ transparence-ia</p>
      <h1 class="mt-4 font-sans text-4xl font-bold text-ink sm:text-5xl">Transparence IA</h1>
      <p class="mt-6 text-muted">
        Certains articles de ce site sont écrits avec l'aide d'une IA, d'autres non. Plutôt que de
        laisser planer le doute, chaque article déclare son niveau de contribution IA — c'est une
        des valeurs distinctives de bencat_ : dire clairement qui a fait quoi.
      </p>
    </section>

    <section class="mx-auto max-w-3xl pb-20">
      {/* Patrons du contrat §4 (R7) : un `.card` posé sur `bg`, les 3 niveaux
          en `.card-inner` dedans (§2.1, pas de saut de surface), chacun avec
          sa bannière d'exemple dans le ton du niveau (D40). */}
      <div class="card p-4 sm:p-6">
        <ul class="flex flex-col gap-4">
          {
            LEVELS.map((level) => {
              const meta = AI_USAGE_META[level];
              return (
                <li class="card-inner p-4 sm:p-5">
                  <p class="font-mono text-xs text-muted">{level}</p>
                  <p class="mt-1 font-sans text-lg font-semibold text-ink">
                    <span aria-hidden="true">{meta.emoji}</span> {meta.label}
                  </p>
                  <p class="mt-2 text-muted">{meta.description}</p>
                  <AiBanner
                    usage={level}
                    ariaLabel={`Exemple de bannière : ${meta.label}`}
                    class="mt-4"
                  />
                </li>
              );
            })
          }
        </ul>

        <p class="mt-4 text-sm text-muted">
          Un article qui ne déclare aucun niveau n'affiche aucune bannière — le champ est optionnel.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
