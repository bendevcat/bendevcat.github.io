---
import { Image } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import { getSortedProjects } from '../../lib/projects';
import { assertEntriesResolved } from '../../lib/references';
import { PROJECT_STATUS_META } from '../../lib/projectStatus';
import { sortAndFilter } from '../../lib/posts';
import { projectTabs } from '../../lib/detailTabs';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status, startDate, stack, cover, coverAlt, repoUrl, demoUrl } =
  project.data;

const statusMeta = PROJECT_STATUS_META[status];

// R5 : les références sont résolues en entrées réelles — on affiche un titre,
// jamais un id ni `undefined`. sortAndFilter (src/lib/posts.ts) écarte au
// passage les articles `draft: true`, qui n'ont pas de route publique : les
// lier produirait un lien mort.
// D06 : assertEntriesResolved échoue avec un message nommant le projet, la
// collection visée et l'id manquant si `getEntries` a renvoyé `undefined`
// pour une référence cassée (cf. src/lib/projects.ts) — au lieu de laisser
// passer un `TypeError` anonyme jusqu'à `sortAndFilter`.
const relatedPosts = project.data.relatedPosts?.length
  ? sortAndFilter(
      assertEntriesResolved(
        project.id,
        project.data.relatedPosts,
        await getEntries(project.data.relatedPosts),
      ),
    )
  : [];

const startDateFr = startDate?.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });

// Plan 8 : QUELS onglets existent se décide dans src/lib/detailTabs.ts, à
// partir de faits bruts — jamais ici. `relatedCount` est compté APRÈS
// sortAndFilter : un article brouillon ne nourrit pas « Articles liés ».
const tabs = projectTabs({
  body: project.body,
  hasCover: Boolean(cover),
  stackCount: stack.length,
  relatedCount: relatedPosts.length,
});
const shown = new Set(tabs.map((tab) => tab.id));
---

<BaseLayout title={`${title} — bencat_`} description={description}>
  <article class="mx-auto max-w-3xl py-10" data-pagefind-body>
    <p class="font-mono text-sm text-accent">~/ projets</p>

    <h1 class="mt-4 font-sans text-4xl font-bold text-ink">{title}</h1>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <span class={`rounded-pill border px-2 py-0.5 font-mono text-xs ${statusMeta.chipClass}`}>
        {statusMeta.label}
      </span>
      {startDateFr && <span class="font-mono text-xs text-muted">depuis {startDateFr}</span>}
    </div>

    <p class="mt-4 text-muted">{description}</p>

    {
      (repoUrl || demoUrl) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {repoUrl && (
            <a
              href={repoUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="rounded-pill border border-line px-3 py-1.5 font-mono text-xs text-ink transition-colors hover:border-accent hover:text-accent"
            >
              code source ↗
            </a>
          )}
          {demoUrl && (
            <a
              href={demoUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="rounded-pill border border-line px-3 py-1.5 font-mono text-xs text-ink transition-colors hover:border-accent hover:text-accent"
            >
              démo ↗
            </a>
          )}
        </div>
      )
    }

    <DetailTabs tabs={tabs} label="Sections du projet">
      {
        shown.has('apercu') && (
          <div slot="apercu">
            {cover && (
              <Image
                src={cover}
                alt={coverAlt ?? ''}
                class="aspect-video w-full rounded-inner object-cover"
              />
            )}
            <div class="prose">
              <Content />
            </div>
          </div>
        )
      }

      {
        shown.has('stack') && (
          <ul slot="stack" class="flex flex-wrap gap-2" aria-label="Technologies">
            {stack.map((tech) => (
              <li class="rounded-pill border border-line px-2 py-0.5 font-mono text-xs text-muted">
                {tech}
              </li>
            ))}
          </ul>
        )
      }

      {
        shown.has('articles-lies') && (
          <ul slot="articles-lies" class="flex flex-col gap-2">
            {relatedPosts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}/`}
                  class="text-body underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </DetailTabs>
  </article>

  <script>
    import '../../scripts/copy-code.ts';
  </script>
</BaseLayout>
