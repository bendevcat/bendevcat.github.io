---
/**
 * Fiche projet (plan 15, T5 ; inventaire §4 ; prototype 433–522 ; D105).
 *
 * `<main>` › `<article data-pagefind-body>` : une grille, 40 px sous le
 * header du site ; à partir de 1024 px `minmax(0,1fr) | 280px`, écart 26 ;
 * en dessous une colonne, carte principale puis barre latérale (ordre du DOM).
 *
 * - Carte principale `.card overflow-hidden` : bandeau 150 px (`Thumbnail`
 *   `banner` : la couverture si elle existe, sinon la trame dérivée),
 *   en-tête (ProjectHeader), onglets soulignés (DetailTabs
 *   `variant="underline"`) Aperçu · Stack (n) · Articles liés (n) — un onglet
 *   sans données est omis (projectTabs, src/lib/detailTabs.ts).
 * - Aperçu : le corps en `.prose` (son premier paragraphe tient le rôle du
 *   « pourquoi » du prototype), puis, 24 px dessous, la fenêtre de code
 *   (CodeWindow) quand `snippet` est renseigné. La couverture ne nourrit plus
 *   Aperçu : c'est le bandeau.
 * - Barre latérale (ProjectAside) : statut, depuis, licence, `code source ↗`,
 *   `démo ↗`, puis la carte Articles liés.
 *
 * Crochets lus par scripts/check-project.mjs : `data-project-main` et ceux
 * des composants de src/components/project/.
 */
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditLink from '../../components/EditLink.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import Thumbnail from '../../components/Thumbnail.astro';
import ProjectHeader from '../../components/project/ProjectHeader.astro';
import CodeWindow from '../../components/project/CodeWindow.astro';
import StackTiles from '../../components/project/StackTiles.astro';
import RelatedPostTiles from '../../components/project/RelatedPostTiles.astro';
import ProjectAside from '../../components/project/ProjectAside.astro';
import { getSortedProjects } from '../../lib/projects';
import { assertEntriesResolved } from '../../lib/references';
import { sortAndFilter } from '../../lib/posts';
import { projectTabs } from '../../lib/detailTabs';
import { projectMetaRows, stackTiles } from '../../lib/projectDetail';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  description,
  status,
  startDate,
  stack,
  stackRoles,
  cover,
  coverAlt,
  license,
  repoUrl,
  demoUrl,
  snippet,
  snippetFile,
} = project.data;

// R5 : les références sont résolues en entrées réelles — on affiche un titre,
// jamais un id ni `undefined`. sortAndFilter (src/lib/posts.ts) écarte au
// passage les articles `draft: true`, qui n'ont pas de route publique : les
// lier produirait un lien mort.
// D06 : assertEntriesResolved échoue avec un message nommant le projet, la
// collection visée et l'id manquant si `getEntries` a renvoyé `undefined`
// pour une référence cassée (cf. src/lib/projects.ts) — au lieu de laisser
// passer un `TypeError` anonyme jusqu'à `sortAndFilter`.
const relatedPosts = project.data.relatedPosts?.length
  ? sortAndFilter(
      assertEntriesResolved(
        project.id,
        project.data.relatedPosts,
        await getEntries(project.data.relatedPosts),
      ),
    )
  : [];

const code = snippet?.trim() ? snippet : undefined;

// QUELS onglets existent se décide dans src/lib/detailTabs.ts, à partir de
// faits bruts — jamais ici. `relatedCount` est compté APRÈS sortAndFilter :
// un article brouillon ne nourrit pas « Articles liés ».
const tabs = projectTabs({
  body: project.body,
  hasSnippet: Boolean(code),
  stackCount: stack.length,
  relatedCount: relatedPosts.length,
});
const shown = new Set(tabs.map((tab) => tab.id));
const hasBody = (project.body ?? '').trim() !== '';

const tiles = stackTiles(stack, stackRoles);
const rows = projectMetaRows({ status, startDate, license });
---

<BaseLayout title={`${title} — bencat_`} description={description}>
  <main>
    <article data-pagefind-body class="grid grid-cols-1 gap-[26px] pt-10 lg:grid-cols-[minmax(0,1fr)_280px] lg:items-start">
      <div class="card min-w-0 overflow-hidden" data-project-main>
        <Thumbnail size="banner" cover={cover} coverAlt={coverAlt} title={title} derivedFrom={status} eager />

        <ProjectHeader title={title} description={description} />

        <DetailTabs tabs={tabs} label="Sections du projet" variant="underline">
          {
            shown.has('apercu') && (
              <div slot="apercu">
                {hasBody && (
                  <div class="prose">
                    <Content />
                  </div>
                )}
                {code && <CodeWindow snippet={code} file={snippetFile} />}
              </div>
            )
          }

          {
            shown.has('stack') && (
              <div slot="stack">
                <StackTiles tiles={tiles} />
              </div>
            )
          }

          {
            shown.has('articles-lies') && (
              <div slot="articles-lies">
                <RelatedPostTiles posts={relatedPosts} />
              </div>
            )
          }
        </DetailTabs>
      </div>

      <ProjectAside rows={rows} repoUrl={repoUrl} demoUrl={demoUrl} posts={relatedPosts} />
    </article>
    <EditLink collection={project.collection} id={project.id} />
  </main>

  <script>
    import '../../scripts/copy-code.ts';
  </script>
</BaseLayout>
