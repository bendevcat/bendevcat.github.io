---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListHeader from '../../components/ListHeader.astro';
import SegmentedControl from '../../components/SegmentedControl.astro';
import Dropdown from '../../components/Dropdown.astro';
import FeaturedProject from '../../components/FeaturedProject.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ListEmpty from '../../components/ListEmpty.astro';
import { getSortedProjects, collectStacks } from '../../lib/projects';
import { projectFacets } from '../../lib/projectFilters';
import { PROJECT_STATUSES } from '../../content.config';
import { ALL } from '../../lib/facetFilters';
import { computeListState, facetCounts, pickFeaturedEntry, type ListLabels } from '../../lib/listPattern';

// Plan 14, T4 (inventaire §3, prototype 344–431 ; D92–D93) : en-tête de liste,
// barre de filtres (statut segmenté à gauche, menu techno à droite), héros
// « à la une » puis grille de `.card` posés sur le fond de page — plus de
// cadre englobant. Pas de carte « prochain projet » (texte de démo, D92).

// getSortedProjects() applique déjà l'ordre du plan (featured, startDate desc,
// titre) — cf. src/lib/projects.ts. Pas de re-tri ici.
const projects = await getSortedProjects();
const stacks = collectStacks(projects);

// Même règle de dérivation que src/scripts/list-pattern.ts (spec §6.1,
// décision I3) : l'entrée à la une est désignée CÔTÉ SERVEUR, pour que le
// héros et sa copie masquée dans la grille pointent exactement vers la même
// entrée que computeListState() désignerait sans filtre.
const featured = pickFeaturedEntry(projects.map((p) => ({ ...p, featured: p.data.featured })));

// Source unique du vocabulaire : `data-list-nouns` ET la méta serveur.
const NOUNS = ['projet', 'projets'] as const;

// Comptes statiques (D93) : chaque valeur comptée sur TOUS les projets
// publiés — `Archivé 0` reste, c'est lui qui mène à l'état vide.
const entries = projects.map((project) => ({
	id: project.id,
	facets: projectFacets({ status: project.data.status, stack: project.data.stack }),
	featured: project.data.featured,
	date: project.data.startDate?.getTime() ?? 0,
	minutes: 0,
}));
const STATUS_LABELS: Record<(typeof PROJECT_STATUSES)[number], string> = {
	actif: 'Actif',
	wip: 'WIP',
	'archivé': 'Archivé',
};
const statusCounts = facetCounts(entries, 'status', [ALL, ...PROJECT_STATUSES]);
const statusSegments = [
	{ value: ALL, label: 'Tous', count: statusCounts[ALL] },
	...PROJECT_STATUSES.map((status) => ({ value: status, label: STATUS_LABELS[status], count: statusCounts[status] })),
];
const stackCounts = facetCounts(entries, 'stack', [ALL, ...stacks]);
const stackOptions = [
	{ value: ALL, label: 'toutes', count: stackCounts[ALL] },
	...stacks.map((tech) => ({ value: tech, label: tech, count: stackCounts[tech] })),
];

// Gabarit de l'état vide (D93) : `{status}` et `{stack}` se remplissent des
// facettes actives, préfixées d'une espace et de ` en `.
const EMPTY_TEMPLATE = "Aucun projet{status}{stack} pour l'instant.";

// Méta serveur = premier texte calculé par le script (D57), par la MÊME
// fonction et les mêmes libellés que ceux que list-pattern.ts lit dans la barre
// (segments d'abord, puis menu). La phrase d'état vide serveur est celle du
// gabarit sans facette ; le script la réécrit avant de l'afficher. (Les
// préfixes d'emplacement vivent sur les contrôles : sans facette active, aucun
// emplacement ne se remplit.)
const labels: ListLabels = {
	singular: NOUNS[0],
	plural: NOUNS[1],
	facets: [
		{ key: 'status', label: 'statut' },
		{ key: 'stack', label: 'techno' },
	],
	emptyTemplate: EMPTY_TEMPLATE,
};
const rest = { status: ALL, stack: ALL };
const { meta } = computeListState(entries, rest, 'none', labels);
const emptyText = computeListState([], rest, 'none', labels).empty ?? '';
---

<BaseLayout
	title="Projets — bencat_"
	description="Les projets de bencat_ : extensions, outils et POCs."
>
	<main>
		<ListHeader path="projets" title="Projets" />

		<section data-list data-list-nouns={NOUNS.join('|')} data-list-empty-template={EMPTY_TEMPLATE}>
			{/* Barre de filtres, 22 px sous le h1 — `hidden` côté serveur, révélée par
			     le script (pas de contrôle mort sans JS). Segments à gauche, menu à
			     droite ; elle passe à la ligne quand la place manque. */}
			<div class="mt-[22px] flex flex-wrap items-center justify-between gap-5" data-list-filters hidden>
				<SegmentedControl
					facetKey="status"
					facetLabel="statut"
					label="Filtrer par statut"
					segments={statusSegments}
					emptyPrefix=" "
				/>
				<Dropdown
					label="techno"
					icon="filter"
					minWidth={230}
					options={stackOptions}
					selected={ALL}
					data-facet-key="stack"
					data-facet-label="techno"
					data-facet-empty-prefix=" en "
				/>
			</div>

			{/* Ligne de méta — le prototype n'en dessine pas : elle reste une région
			     live polie et atomique (plan 11, R6), visuellement masquée (D93). */}
			<p class="sr-only text-muted" data-list-meta aria-live="polite" aria-atomic="true">{meta}</p>

			{/* Contenu, 18 px sous la barre : héros, grille, état vide — sans cadre
			     (D92). L'écart est un `gap` : un bloc `hidden` n'en laisse aucun. */}
			<div class="mt-[18px] flex flex-col gap-[18px]">
				{/* Héros — UNE seule entrée, désignée côté serveur (décision I3) ;
				     masqué par le script dès qu'une facette est active. */}
				<div data-list-featured>
					{featured && <FeaturedProject project={featured} />}
				</div>

				{/* Grille — contient TOUTES les entrées ; celle du héros y est rendue
				     `hidden` PAR LE SERVEUR, pour que sans JavaScript la page montre
				     chaque entrée exactement une fois (contrainte globale n°5). */}
				<div class="grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3" data-list-grid>
					{
						projects.map((project) => (
							<ProjectCard
								project={project}
								hidden={project.id === featured?.id}
								isFeaturedEntry={project.id === featured?.id}
							/>
						))
					}
				</div>

				<ListEmpty icon="folder" text={emptyText} resetLabel="voir tous les projets →" />
			</div>
		</section>

		<script>
			import '../../scripts/list-pattern.ts';
		</script>
	</main>
</BaseLayout>
