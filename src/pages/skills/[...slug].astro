---
/**
 * Fiche skill (plan 17, T4 ; inventaire §8 ; prototype 795–923 ; D115–D117).
 *
 * `<main>` › `<article data-pagefind-body>`, 40 px sous le header du site :
 * l'en-tête (SkillHeader, sans carte), puis, 28 px dessous, une grille — à
 * partir de 1024 px `minmax(0,1fr) | 340px`, écart 22, `items-start` ; en
 * dessous une colonne, blocs de gauche puis colonne latérale (ordre du DOM).
 *
 * - Gauche (écart 16) : fenêtre d'installation (InstallWindow, omise sans
 *   `installCmd`) › `Ce que fait ce skill` (SkillHighlights, omise sans
 *   `highlights`) › explorateur (FileExplorer, omis sans `files`) ›
 *   `En détail` (SkillNotes : le corps, omis quand il est blanc).
 * - Colonne `<aside aria-label="Autour du skill">`, écart 12, collante à
 *   20 px du haut à partir de 1024 px seulement : onglets en piste
 *   (DetailTabs `variant="track"`) déclencheurs · versions · infos — un
 *   onglet sans données est omis (skillPageTabs, src/lib/detailTabs.ts) ;
 *   puis `Prompts du skill` (RelatedPromptsCard), omise sans prompt lié.
 * - Le résumé `N skill(s) · N commande(s) · N prompt(s)` est celui de la
 *   carte de `/skills/` (skillCardData, src/lib/listCards.ts) ; `maj.` est la
 *   date de la ligne du journal de la version affichée (skillUpdated).
 *
 * Crochets lus par scripts/check-skill.mjs : `data-skill-aside`,
 * `data-skill-left` et ceux des composants de src/components/skill/.
 */
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import RelatedPromptsCard from '../../components/prompt/RelatedPromptsCard.astro';
import SkillHeader from '../../components/skill/SkillHeader.astro';
import InstallWindow from '../../components/skill/InstallWindow.astro';
import SkillHighlights from '../../components/skill/SkillHighlights.astro';
import FileExplorer from '../../components/skill/FileExplorer.astro';
import SkillNotes from '../../components/skill/SkillNotes.astro';
import SkillTriggers from '../../components/skill/SkillTriggers.astro';
import SkillVersions from '../../components/skill/SkillVersions.astro';
import SkillInfos from '../../components/skill/SkillInfos.astro';
import { getSortedSkills } from '../../lib/skills';
import { sortAndFilterPrompts } from '../../lib/prompts';
import { assertEntriesResolved } from '../../lib/references';
import { skillPageTabs } from '../../lib/detailTabs';
import { skillCardData } from '../../lib/listCards';
import { installSteps, skillUpdated, toolLabel, updatedLabel } from '../../lib/skillDetail';

export async function getStaticPaths() {
  const skills = await getSortedSkills();
  return skills.map((skill) => ({ params: { slug: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);
const { title, name, description, type, version, repoUrl, installCmd, installNote, tags } = skill.data;
const highlights = skill.data.highlights ?? [];
const triggers = skill.data.triggers ?? [];
const changelog = skill.data.changelog ?? [];
const files = skill.data.files ?? [];

// D06 : une référence cassée fait échouer le build en nommant le skill et
// l'id manquant (assertEntriesResolved, appelé EN PREMIER) ; puis
// sortAndFilterPrompts écarte les brouillons (pas de page) et trie A→Z.
const resolved = skill.data.relatedPrompts?.length
  ? assertEntriesResolved(skill.id, skill.data.relatedPrompts, await getEntries(skill.data.relatedPrompts))
  : [];
const relatedPrompts = sortAndFilterPrompts(resolved);

// En-tête et infos : les mêmes chaînes que la carte de /skills/.
const card = skillCardData(skill.data, resolved);
const updated = skillUpdated(version, changelog);
const updatedText = updatedLabel(updated);
const steps = installSteps(installCmd);
const hasBody = (skill.body ?? '').trim() !== '';

// QUELS onglets existent se décide dans src/lib/detailTabs.ts.
const tabs = skillPageTabs({ triggerCount: triggers.length, changelogCount: changelog.length });
const shown = new Set(tabs.map((tab) => tab.id));
---

<BaseLayout title={`${title} — bencat_`} description={description}>
  <main>
    <article data-pagefind-body class="pt-10">
      <SkillHeader
        id={skill.id}
        title={title}
        name={name}
        description={description}
        type={card.type}
        version={card.version}
        license={card.license}
        summary={card.summary}
        updated={updated}
        updatedLabel={updatedText}
      />

      <div class="mt-7 grid grid-cols-1 gap-[22px] lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
        <div class="flex min-w-0 flex-col gap-4" data-skill-left>
          {
            installCmd && steps.length > 0 && (
              <InstallWindow installCmd={installCmd} steps={steps} tool={toolLabel(type)} note={installNote} />
            )
          }

          {highlights.length > 0 && <SkillHighlights highlights={highlights} />}

          {files.length > 0 && <FileExplorer files={files} source={skill.data.filesSource} name={name} />}

          {
            hasBody && (
              <SkillNotes>
                <Content />
              </SkillNotes>
            )
          }
        </div>

        <aside aria-label="Autour du skill" class="flex min-w-0 flex-col gap-3 lg:sticky lg:top-5" data-skill-aside>
          <DetailTabs tabs={tabs} label="Sections du skill" variant="track">
            {
              shown.has('declencheurs') && (
                <div slot="declencheurs">
                  <SkillTriggers triggers={triggers} />
                </div>
              )
            }

            {
              shown.has('versions') && (
                <div slot="versions">
                  <SkillVersions changelog={changelog} />
                </div>
              )
            }

            {
              shown.has('infos') && (
                <div slot="infos">
                  <SkillInfos
                    type={card.type}
                    version={card.version}
                    license={card.license}
                    summary={card.summary}
                    updated={updatedText}
                    tags={tags}
                    repoUrl={repoUrl}
                  />
                </div>
              )
            }
          </DetailTabs>

          {
            relatedPrompts.length > 0 && (
              <RelatedPromptsCard
                label="Prompts du skill"
                headingId="skill-related-prompts"
                tool={false}
                prompts={relatedPrompts.map((entry) => ({
                  id: entry.id,
                  title: entry.data.title,
                  format: entry.data.format,
                  tool: entry.data.tool,
                }))}
              />
            )
          }
        </aside>
      </div>
    </article>
  </main>

  <script>
    import '../../scripts/skill-page.ts';
    import '../../scripts/copy-code.ts';
  </script>
</BaseLayout>
