---
import { getEntries } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListHeader from '../../components/ListHeader.astro';
import SegmentedControl from '../../components/SegmentedControl.astro';
import Dropdown from '../../components/Dropdown.astro';
import SkillCard from '../../components/SkillCard.astro';
import ListEmpty from '../../components/ListEmpty.astro';
import { getSortedSkills, collectTypes, collectSkillTags } from '../../lib/skills';
import { assertEntriesResolved } from '../../lib/references';
import { ALL } from '../../lib/facetFilters';
import { computeListState, facetCounts, type ListLabels } from '../../lib/listPattern';

// Plan 14, T5 (inventaire §7, prototype 738–793 ; D92–D95) : en-tête de
// liste, barre de filtres (type segmenté à gauche, menu tag à droite), puis
// une grille de cartes compactes posées sur le fond de page — ni vignette, ni
// entrée à la une, ni puces de tag.

// getSortedSkills() applique déjà l'ordre du plan (titre A→Z) et écarte les
// `draft` — cf. src/lib/skills.ts. Pas de re-tri ici.
const skills = await getSortedSkills();
const types = collectTypes(skills);
const tags = collectSkillTags(skills);

// Résumé de contenu des cartes (D94) : les prompts liés, résolus comme sur la
// page de détail — assertEntriesResolved (D06) fait échouer le build en
// nommant la skill et l'id manquant ; skillCardData() n'en compte que les
// publiés.
const related = new Map(
	await Promise.all(
		skills.map(async (skill) => {
			const refs = skill.data.relatedPrompts ?? [];
			const resolved = refs.length ? assertEntriesResolved(skill.id, refs, await getEntries(refs)) : [];
			return [skill.id, resolved] as const;
		}),
	),
);

// Source unique du vocabulaire : `data-list-nouns` ET la méta serveur.
const NOUNS = ['skill', 'skills'] as const;

// Comptes statiques (D93) : chaque valeur comptée sur TOUTES les skills publiées.
const entries = skills.map((skill) => ({
	id: skill.id,
	facets: { type: [skill.data.type], tag: skill.data.tags },
	featured: false,
	date: 0,
	minutes: 0,
}));
// Types écrits tels quels (D93) : `claude-code`.
const typeCounts = facetCounts(entries, 'type', [ALL, ...types]);
const typeSegments = [
	{ value: ALL, label: 'Tous', count: typeCounts[ALL] },
	...types.map((type) => ({ value: type, label: type, count: typeCounts[type] })),
];
const tagCounts = facetCounts(entries, 'tag', [ALL, ...tags]);
const tagOptions = [
	{ value: ALL, label: 'tous', count: tagCounts[ALL] },
	...tags.map((tag) => ({ value: tag, label: tag, count: tagCounts[tag] })),
];

// Phrase d'état vide du prototype (D93) : un gabarit sans emplacement, donc
// la même quelles que soient les facettes actives.
const EMPTY_TEMPLATE = 'Aucune skill ne correspond à ce filtre.';

// Méta serveur = premier texte calculé par le script (D57), par la MÊME
// fonction et les mêmes libellés que ceux que list-pattern.ts lit dans la
// barre (segments d'abord, puis menu).
const labels: ListLabels = {
	singular: NOUNS[0],
	plural: NOUNS[1],
	facets: [
		{ key: 'type', label: 'type' },
		{ key: 'tag', label: 'tag' },
	],
	emptyTemplate: EMPTY_TEMPLATE,
};
const rest = { type: ALL, tag: ALL };
const { meta } = computeListState(entries, rest, 'none', labels, { featured: false });
const emptyText = computeListState([], rest, 'none', labels, { featured: false }).empty ?? '';
---

<BaseLayout
	title="Skills — bencat_"
	description="Les skills Claude Code de bencat_ : instructions, installation et prompts liés."
>
	<main>
		<ListHeader path="skills" title="Skills" />

		<section data-list data-list-nouns={NOUNS.join('|')} data-list-empty-template={EMPTY_TEMPLATE}>
			{/* Barre de filtres, 22 px sous le h1 — `hidden` côté serveur, révélée par
			     le script (pas de contrôle mort sans JS). */}
			<div class="mt-[22px] flex flex-wrap items-center justify-between gap-5" data-list-filters hidden>
				<SegmentedControl facetKey="type" facetLabel="type" label="Filtrer par type" segments={typeSegments} />
				<Dropdown
					label="tag"
					icon="filter"
					minWidth={230}
					options={tagOptions}
					selected={ALL}
					data-facet-key="tag"
					data-facet-label="tag"
				/>
			</div>

			{/* Ligne de méta — région live polie et atomique (plan 11, R6),
			     visuellement masquée : le prototype n'en dessine pas (D93). */}
			<p class="sr-only text-muted" data-list-meta aria-live="polite" aria-atomic="true">{meta}</p>

			{/* Contenu, 18 px sous la barre : grille puis état vide, sans cadre (D92). */}
			<div class="mt-[18px] flex flex-col gap-[18px]">
				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-list-grid>
					{skills.map((skill) => <SkillCard skill={skill} relatedPrompts={related.get(skill.id) ?? []} />)}
				</div>

				<ListEmpty icon="filter" text={emptyText} resetLabel="réinitialiser les filtres →" />
			</div>
		</section>

		<script>
			import '../../scripts/list-pattern.ts';
		</script>
	</main>
</BaseLayout>
