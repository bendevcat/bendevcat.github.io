---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagChip from '../../components/TagChip.astro';
import { collectTagIndex, getTagBuckets } from '../../lib/tags';

const tags = collectTagIndex(await getTagBuckets());
---

<BaseLayout title="Tags — bencat_" description="Tous les tags des articles, projets, prompts et skills de bencat_.">
  <main>
    <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <p class="font-mono text-sm text-accent">~/ tags</p>
      <h1 class="mt-4 font-sans text-4xl font-bold text-ink sm:text-5xl">Tags</h1>
    </section>

    <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
      {/* Un `.card` posé sur `bg` autour des puces (contrat §4, R7). */}
      {
        tags.length === 0 ? (
          <p class="text-sm text-muted">Aucun tag n'a encore été renseigné.</p>
        ) : (
          <div class="card p-4 sm:p-6">
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li>
                  <TagChip
                    tag={tag.label}
                    href={`/tags/${tag.slug}/`}
                    label={`${tag.label} ${tag.count}`}
                    class="px-3 py-1"
                  >
                    <span>{tag.count}</span>
                  </TagChip>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>
