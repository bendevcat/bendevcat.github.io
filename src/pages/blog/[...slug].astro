---
/**
 * Page article (plan 13, T4 ; inventaire §2 ; prototype 230–342 ; D86, D87).
 *
 * `<main>` › `<article data-pagefind-body>` : l'en-tête (fil d'Ariane, h1,
 * méta) puis UN cadre `.card` en trois colonnes à partir de 1024 px —
 * `250px | minmax(0,1fr) | 230px`. Ordre du DOM : centre → rail droit →
 * rail gauche, placés par colonnes de grille ; sous 1024 px les trois
 * s'empilent dans cet ordre (l'article d'abord sur un téléphone). Sans
 * Sommaire ni Projets liés, le rail droit est omis et la grille passe à
 * `250px | 1fr`.
 *
 * Les rails, la carte IA et les tuiles précédent / suivant portent
 * `data-pagefind-ignore` : la recherche indexe le titre, la méta et la prose,
 * pas la navigation (R13). La bannière IA du haut a quitté l'article : la carte IA
 * de fin la remplace (D87) ; la bannière ne sert plus que /transparence-ia (R19).
 */
import { Image } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import { getPublishedPosts } from '../../lib/posts';
import { sortProjects } from '../../lib/projects';
import { assertEntriesResolved } from '../../lib/references';
import { adjacentPosts, relatedPosts, tocEntries } from '../../lib/article';
import { blogCategoryRows, blogTagCloud } from '../../lib/blogList';
import { CATEGORIES } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/blog/ArticleHeader.astro';
import ArticleAside from '../../components/blog/ArticleAside.astro';
import AiMarkerCard from '../../components/blog/AiMarkerCard.astro';
import BlogRail from '../../components/blog/BlogRail.astro';
import PrevNext from '../../components/blog/PrevNext.astro';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';

export async function getStaticPaths() {
  // getPublishedPosts() filtre les drafts (R4/R6) — cf. C2 (src/pages/blog/index.astro)
  // et C1 (src/pages/index.astro), qui filtrent déjà de la même façon : un
  // draft:true ne doit obtenir NI carte d'index NI route publique.
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Toute la collection publiée, dans l'ordre canonique : rail gauche (mêmes
// catégories et tags que /blog), articles liés, précédent / suivant.
const posts = await getPublishedPosts();
const categories = blogCategoryRows(posts, CATEGORIES);
const tags = blogTagCloud(posts);
const related = relatedPosts(post, posts);
const { previous, next } = adjacentPosts(post, posts);

// R5, sens article → projets : les références sont résolues en entrées réelles
// pour afficher un titre, jamais un id ni `undefined`. Les projets n'ont pas de
// champ `draft` (spec de design §3.2) : rien à filtrer, seulement à ordonner.
// D06 : assertEntriesResolved échoue avec un message nommant l'article, la
// collection visée et l'id manquant si `getEntries` a renvoyé `undefined` pour
// une référence cassée (cf. src/lib/projects.ts), au lieu de laisser passer un
// `TypeError` anonyme jusqu'à `sortProjects`.
const relatedProjects = post.data.relatedProjects?.length
  ? sortProjects(
      assertEntriesResolved(
        post.id,
        post.data.relatedProjects,
        await getEntries(post.data.relatedProjects),
      ),
    )
  : [];

// Rail droit omis quand il n'aurait rien à montrer (D86).
const hasRightRail = tocEntries(headings).length > 0 || relatedProjects.length > 0;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main>
    <article data-pagefind-body>
      <ArticleHeader post={post} />

      {/* Cadre unique (V2, D51). `overflow-hidden` rogne le fond des rails sur
           le rayon du cadre. Classes de grille littérales (Tailwind, D41). */}
      <div
        class:list={[
          'card mt-[26px] overflow-hidden',
          hasRightRail
            ? 'lg:grid lg:grid-cols-[250px_minmax(0,1fr)_230px]'
            : 'lg:grid lg:grid-cols-[250px_minmax(0,1fr)]',
        ]}
      >
        <div class="min-w-0 px-5 pt-7 pb-8 sm:px-10 sm:pt-[34px] sm:pb-11 lg:col-start-2 lg:row-start-1">
          <p class="font-sans text-[17px] leading-[1.6] text-pretty text-muted">{post.data.description}</p>

          {
            post.data.cover && (
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt ?? ''}
                loading="eager"
                class="mt-6 h-[210px] w-full rounded-hero bg-chip object-cover"
              />
            )
          }

          <div class="prose mt-[34px]">
            <Content />
          </div>

          {post.data.aiUsage && <AiMarkerCard usage={post.data.aiUsage} />}

          <PrevNext previous={previous} next={next} />
        </div>

        {
          hasRightRail && (
            <ArticleAside headings={headings} projects={relatedProjects} class="lg:col-start-3 lg:row-start-1" />
          )
        }

        <BlogRail
          categories={categories}
          tags={tags}
          variant="links"
          label="Catégories, tags et articles liés"
          class="lg:col-start-1 lg:row-start-1"
        >
          <RelatedPosts posts={related} />
        </BlogRail>
      </div>
    </article>
  </main>

  <script>
    import '../../scripts/copy-code.ts';
  </script>
</BaseLayout>
