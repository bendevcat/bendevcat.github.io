---
import { Image } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import { getPublishedPosts } from '../../lib/posts';
import { sortProjects } from '../../lib/projects';
import { assertEntriesResolved } from '../../lib/references';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import AiBanner from '../../components/AiBanner.astro';

export async function getStaticPaths() {
  // getPublishedPosts() filtre les drafts (R4/R6) — cf. C2 (src/pages/blog/index.astro)
  // et C1 (src/pages/index.astro), qui filtrent déjà de la même façon : un
  // draft:true ne doit obtenir NI carte d'index NI route publique.
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// TOC = uniquement H2/H3 (cf. brief C3 gotcha #4) ; TableOfContents.astro se
// masque lui-même si la liste est vide (pas d'encart TOC vide).
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// R5, sens article → projets : les références sont résolues en entrées réelles
// pour afficher un titre, jamais un id ni `undefined`. Les projets n'ont pas de
// champ `draft` (spec de design §3.2) : rien à filtrer, seulement à ordonner.
// D06 : assertEntriesResolved échoue avec un message nommant l'article, la
// collection visée et l'id manquant si `getEntries` a renvoyé `undefined` pour
// une référence cassée (cf. src/lib/projects.ts), au lieu de laisser passer un
// `TypeError` anonyme jusqu'à `sortProjects`.
const relatedProjects = post.data.relatedProjects?.length
  ? sortProjects(
      assertEntriesResolved(
        post.id,
        post.data.relatedProjects,
        await getEntries(post.data.relatedProjects),
      ),
    )
  : [];
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="mb-6 font-display text-4xl font-bold text-text">{post.data.title}</h1>

    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt ?? ''}
          class="mb-8 aspect-video w-full rounded-lg object-cover"
        />
      )
    }

    {post.data.aiUsage && <AiBanner usage={post.data.aiUsage} />}

    <TableOfContents headings={tocHeadings} />

    <div class="prose">
      <Content />
    </div>

    {
      relatedProjects.length > 0 && (
        <section class="mt-12 border-t border-line pt-8">
          <h2 class="font-mono text-sm text-muted">// projets liés</h2>
          <ul class="mt-4 flex flex-col gap-2">
            {relatedProjects.map((project) => (
              <li>
                <a
                  href={`/projets/${project.id}/`}
                  class="text-text underline decoration-line underline-offset-4 transition-colors hover:text-acc hover:decoration-acc"
                >
                  {project.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <script>
    import '../../scripts/copy-code.ts';
  </script>
</BaseLayout>
