---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { collectTagIndex } from '../../lib/tags';
import { CATEGORIES } from '../../content.config';
import { ALL } from '../../lib/facetFilters';

const posts = await getPublishedPosts();
// getPublishedPosts() filtre les drafts et trie déjà par pubDate desc
// (src/lib/posts.ts) — pas de re-tri ici, conformément au plan d'impl C2.

// Seuls les tags PRÉSENTS dans les articles publiés : proposer un tag qui ne
// filtre rien donnerait une liste vide sans que l'utilisateur comprenne.
const blogTags = collectTagIndex({ blog: posts, projects: [], prompts: [], skills: [] });
// Idem côté catégories : CATEGORIES en liste 7 valeurs possibles, toutes ne
// sont pas forcément utilisées.
const usedCategories = CATEGORIES.filter((c) => posts.some((p) => p.data.category === c));
---

<BaseLayout
	title="Blog — bencat_"
	description="Tous les articles du blog bencat_ : DevOps, IA et geekeries diverses."
>
	<main>
		<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
			<p class="font-mono text-sm text-acc">~/ blog</p>
			<h1 class="mt-4 font-sans text-4xl font-bold text-text sm:text-5xl">Blog</h1>
		</section>

		<section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
			{/*
				`hidden` côté serveur : révélé par src/scripts/facet-filters.ts.
				Sans JS, aucun contrôle mort n'est affiché et toutes les cartes
				restent visibles (enhancement progressif, spec §6.3).
			*/}
			<div
				class="mb-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between"
				data-facet-filters
				hidden
			>
				<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrer par catégorie">
					<button
						type="button"
						data-facet-key="category"
						data-facet-value={ALL}
						aria-pressed="true"
						class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-acc hover:text-acc aria-pressed:border-acc aria-pressed:text-acc"
					>
						toutes
					</button>
					{
						usedCategories.map((cat) => (
							<button
								type="button"
								data-facet-key="category"
								data-facet-value={cat}
								aria-pressed="false"
								class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-acc hover:text-acc aria-pressed:border-acc aria-pressed:text-acc"
							>
								{cat}
							</button>
						))
					}
				</div>

				{
					blogTags.length > 0 && (
						<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrer par tag">
							<button
								type="button"
								data-facet-key="tag"
								data-facet-value={ALL}
								aria-pressed="true"
								class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-acc hover:text-acc aria-pressed:border-acc aria-pressed:text-acc"
							>
								tous
							</button>
							{
								blogTags.map((tag) => (
									<button
										type="button"
										data-facet-key="tag"
										data-facet-value={tag.slug}
										aria-pressed="false"
										class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-acc hover:text-acc aria-pressed:border-acc aria-pressed:text-acc"
									>
										{tag.label} <span class="text-acc">{tag.count}</span>
									</button>
								))
							}
						</div>
					)
				}
			</div>

			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => <ArticleCard post={post} filterable />)}
			</div>

			<p class="mt-8 font-mono text-sm text-muted" data-facet-empty hidden>
				Aucun article ne correspond à ce filtre.
			</p>

			<p class="mt-4">
				<a href="/tags/" class="font-mono text-xs text-muted transition-colors hover:text-acc">
					tous les tags →
				</a>
			</p>
		</section>

		<script>
			import '../../scripts/facet-filters.ts';
			import '../../scripts/blog-filters.ts';
		</script>
	</main>
</BaseLayout>
