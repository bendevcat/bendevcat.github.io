---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
// getPublishedPosts() filtre les drafts et trie déjà par pubDate desc
// (src/lib/posts.ts) — pas de re-tri ici, conformément au plan d'impl C2.
---

<BaseLayout
	title="Blog — bencat_"
	description="Tous les articles du blog bencat_ : DevOps, IA et geekeries diverses."
>
	<main>
		<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
			<p class="font-mono text-sm text-acc">~/ blog</p>
			<h1 class="mt-4 font-display text-4xl font-bold text-text sm:text-5xl">Blog</h1>
		</section>

		<section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</section>
	</main>
</BaseLayout>
