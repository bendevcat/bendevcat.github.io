---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListHeader from '../../components/ListHeader.astro';
import Dropdown from '../../components/Dropdown.astro';
import type { IconName } from '../../components/Icon.astro';
import BlogRail from '../../components/blog/BlogRail.astro';
import ArticleRow from '../../components/blog/ArticleRow.astro';
import { getPublishedPosts, estimateReadingMinutes } from '../../lib/posts';
import { CATEGORIES } from '../../content.config';
import { ALL } from '../../lib/facetFilters';
import { blogCategoryRows, blogTagCloud, ALL_CATEGORIES_LABEL } from '../../lib/blogList';
import { computeListState, type ListLabels, type SortOrder } from '../../lib/listPattern';

// Plan 12, T5 (inventaire §1, prototype 163–227 ; D73–D75) : un `.card` avec
// le rail à gauche (Catégories filtrantes, nuage de tags) et la colonne des
// lignes compactes sous une barre d'outils (méta + menu de tri). Pas d'entrée
// à la une, pas de filtre par tag, pas de `tous les tags →`.

const posts = await getPublishedPosts();
// getPublishedPosts() filtre les drafts et trie déjà par pubDate desc
// (src/lib/posts.ts) : c'est l'ordre canonique ET celui du tri par défaut
// `plus récents` — le serveur rend donc les lignes dans l'ordre que le script
// calculera au chargement.

// Plan 12, F4 : la ligne de l'article que l'accueil met à la une porte
// `data-featured` (scripts/check-home.mjs compare les deux). Même règle que
// pickHomePosts() → pickFeaturedEntry() : le PREMIER `featured: true` de
// l'ordre canonique ; aucun → aucune marque (l'accueil prend alors la
// première ligne, que check-home.mjs lit à défaut).
const featuredId = posts.find((post) => post.data.featured)?.id;

const categories = blogCategoryRows(posts, CATEGORIES);
const tags = blogTagCloud(posts);

// Source unique du vocabulaire : `data-list-nouns` ET la méta serveur.
const NOUNS = ['article', 'articles'] as const;

// Icônes et largeur du popover (250 px) : celles du prototype (plan 12, F3).
const SORT_OPTIONS: { value: SortOrder; label: string; icon: IconName }[] = [
	{ value: 'recent', label: 'plus récents', icon: 'sort-recent' },
	{ value: 'oldest', label: 'plus anciens', icon: 'sort-oldest' },
	{ value: 'shortest', label: 'lecture la plus courte', icon: 'sort-shortest' },
	{ value: 'longest', label: 'lecture la plus longue', icon: 'sort-longest' },
];
const INITIAL_SORT: SortOrder = 'recent';

// Méta serveur = premier texte calculé par le script (D57 : aucune réécriture
// au chargement) — donc calculée par la MÊME fonction, avec les mêmes
// libellés que ceux que list-pattern.ts lit dans le rail.
const labels: ListLabels = {
	singular: NOUNS[0],
	plural: NOUNS[1],
	facets: [{ key: 'category', label: 'catégorie', allLabel: ALL_CATEGORIES_LABEL }],
};
const { meta } = computeListState(
	posts.map((post) => ({
		id: post.id,
		facets: { category: [post.data.category] },
		featured: false,
		date: post.data.pubDate.getTime(),
		minutes: estimateReadingMinutes(post.body ?? ''),
	})),
	{ category: ALL },
	INITIAL_SORT,
	labels,
	{ featured: false },
);
---

<BaseLayout
	title="Blog — bencat_"
	description="Tous les articles du blog bencat_ : DevOps, IA et geekeries diverses."
>
	<main>
		<ListHeader path="blog" title="Blog" />

		<section class="mt-[26px]" data-list data-list-nouns={NOUNS.join('|')}>
			{/* Cadre unique (V2, D51) : rail + colonne principale. `overflow-hidden`
			     rogne le fond du rail sur le rayon du cadre. Sous 768 px, le rail
			     s'empile au-dessus de la liste (D73). */}
			<div class="card overflow-hidden md:grid md:grid-cols-[250px_minmax(0,1fr)]" data-list-frame>
				<BlogRail categories={categories} tags={tags} selected={ALL} />

				<div class="flex min-w-0 flex-col px-5 pt-6 pb-[30px] sm:px-7">
					{/* Barre d'outils : méta à gauche, tri à droite. Le menu est rendu
					     `hidden` et révélé par son script (pas de contrôle mort sans JS). */}
					<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-line2 pb-4">
						{/* Ligne de méta — région live polie et atomique (plan 11, R6) que
						     list-pattern.ts réécrit à chaque filtre ; `muted`, jamais `dim`. */}
						<p class="font-mono text-xs text-muted" data-list-meta aria-live="polite" aria-atomic="true">{meta}</p>
						<Dropdown label="tri" options={SORT_OPTIONS} selected={INITIAL_SORT} minWidth={250} data-sort />
					</div>

					{/* Lignes — toutes rendues par le serveur, dans l'ordre canonique. */}
					<div class="flex flex-col" data-list-grid>
						{posts.map((post, index) => <ArticleRow post={post} eager={index === 0} featured={post.id === featuredId} />)}
					</div>

					{/* État vide — inatteignable tant que chaque ligne du rail compte au
					     moins un article, gardé pour le contrat du moteur. */}
					<div class="flex flex-col items-start gap-3 pt-6" data-list-empty hidden>
						<p class="text-sm text-muted" data-list-empty-text></p>
						<button
							type="button"
							data-list-reset
							class="rounded-pill border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
						>
							voir tous les articles
						</button>
					</div>
				</div>
			</div>
		</section>

		<script>
			import '../../scripts/list-pattern.ts';
		</script>
	</main>
</BaseLayout>
