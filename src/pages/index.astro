---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/home/FeaturedPost.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import { getPublishedPosts } from '../lib/posts';
import { pickHomePosts } from '../lib/home';

// Plan 9 — accueil du prototype (contrat E3) : plus de hero (D27, Hero.astro
// gardé inutilisé pour le plan 10, D33).
//
// UN SEUL tableau (D35) : getPublishedPosts() donne l'ordre canonique (drafts
// retirés, pubDate desc) ; on l'enveloppe une fois pour exposer `featured` à
// pickHomePosts(), comme /blog le fait pour pickFeaturedEntry() — même règle,
// même entrée à la une. L'exclusion de l'article à la une dans `latest` se
// fait par identité d'objet : ne jamais recréer les enveloppes entre les deux.
const entries = (await getPublishedPosts()).map((post) => ({ post, featured: post.data.featured }));
const { featured, latest } = pickHomePosts(entries);
---

<BaseLayout
	title="bencat_"
	description="Site perso de Benoît Catillon — blog, projets, prompts et skills."
>
	<main class="mx-auto flex max-w-5xl flex-col gap-5 px-4 pt-6 pb-20 sm:px-6 sm:pt-8">
		{/* Un seul <h1> sur la page, le nom du site, masqué visuellement (D32). */}
		<h1 class="sr-only">bencat_</h1>

		{/* Rangée 1 : empilée en étroit, côte à côte en large (prototype 1.35fr / 1fr). */}
		<div class="grid grid-cols-1 gap-5 lg:grid-cols-[1.35fr_1fr]">
			{featured && <FeaturedPost post={featured.post} />}
			{latest.length > 0 && <LatestPosts posts={latest.map((entry) => entry.post)} />}
		</div>
	</main>
</BaseLayout>
